<h1 class="mb-4"><%= t('bulk_searches.title') %></h1>

<div class="card mb-4">
  <div class="card-body">
    <p><%= t('bulk_searches.description') %></p>

    <div class="alert alert-light border mb-4" style="background-color: var(--vg-bg-surface); border-color: var(--vg-border) !important;">
      <h6><%= t('bulk_searches.how_to_title') %></h6>
      <ol class="mb-2">
        <li><%= t('bulk_searches.how_to_step_1') %></li>
        <li><%= t('bulk_searches.how_to_step_2') %></li>
        <li><%= t('bulk_searches.how_to_step_3') %></li>
      </ol>
      <p class="mb-1"><strong><%= t('bulk_searches.format_title') %></strong></p>
      <code class="d-block p-2 rounded" style="background-color: var(--vg-bg); white-space: pre-line;"><%= t('bulk_searches.format_example') %></code>
    </div>

    <%= form_tag search_bulk_searches_path, method: :get do %>
      <div class="mb-3">
        <textarea name="bulk_search" class="form-control" rows="10" placeholder="<%= t('bulk_searches.placeholder') %>" required></textarea>
      </div>
      <%= submit_tag t('bulk_searches.search'), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
