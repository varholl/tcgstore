<!DOCTYPE html>
<html>
  <head>
    <title>Varholl Garage Sale</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <%= stylesheet_link_tag 'application' %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
      <div class="container">
        <%= link_to t('nav.brand'), root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to cards_path, class: "nav-link", title: t('nav.cards'), data: { bs_toggle: "tooltip" } do %>
                <i class="fas fa-layer-group"></i>
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to how_it_works_path, class: "btn btn-outline-light btn-sm" do %>
                <i class="fas fa-info-circle me-1"></i><%= t('nav.how_it_works') %>
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to about_path, class: "nav-link", title: t('nav.about_this_site'), data: { bs_toggle: "tooltip" } do %>
                <i class="fas fa-user"></i>
              <% end %>
            </li>
          </ul>
          <ul class="navbar-nav">
            <li class="nav-item">
              <select class="form-select form-select-sm" style="width: auto;" onchange="fetch(this.value, { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('meta[name=csrf-token]').content } }).then(() => window.location.reload())">
                <option value="<%= set_language_path(:es) %>" <%= 'selected' if I18n.locale == :es %>>ES</option>
                <option value="<%= set_language_path(:en) %>" <%= 'selected' if I18n.locale == :en %>>EN</option>
              </select>
            </li>
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to cart_items_path, class: "nav-link", title: t('nav.cart'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-shopping-cart"></i>
                  <% count = current_user.cart_items.sum(:quantity) %>
                  <% if count > 0 %>
                    <span class="badge bg-primary rounded-pill"><%= count %></span>
                  <% end %>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to reservations_path, class: "nav-link", title: t('nav.my_reservations'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-clipboard-list"></i>
                <% end %>
              </li>
              <% if current_user.admin? %>
                <li class="nav-item">
                  <%= link_to admin_reservations_path, class: "nav-link", title: t('nav.admin'), data: { bs_toggle: "tooltip" } do %>
                    <i class="fas fa-shield-halved"></i>
                  <% end %>
                </li>
              <% end %>
              <li class="nav-item">
                <%= link_to edit_profile_path, class: "nav-link", title: t('nav.profile'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-user-circle"></i>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to destroy_user_session_path, data: { turbo_method: :delete, bs_toggle: "tooltip" }, class: "nav-link", title: t('nav.sign_out') do %>
                  <i class="fas fa-sign-out-alt"></i>
                <% end %>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to new_user_session_path, class: "nav-link", title: t('nav.sign_in'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-sign-in-alt"></i>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to new_user_registration_path, class: "nav-link", title: t('nav.sign_up'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-user-plus"></i>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container flex-grow-1">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <footer class="text-light mt-auto py-3 bg-dark">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
            <span>&copy; <%= Date.today.year %> Varholl Garage Sale</span>
            <span class="text-secondary ms-2"><%= t('footer.tagline') %></span>
          </div>
          <div class="col-md-6 text-center text-md-end">
            <a href="https://www.instagram.com/varholl_mtg" target="_blank" rel="noopener noreferrer" class="footer-link text-light text-decoration-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align: -2px;">
                <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
              </svg>
              @varholl_mtg
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
          new bootstrap.Tooltip(el);
        });
      });
    </script>
  </body>
</html>
