<!DOCTYPE html>
<html data-theme="<%= current_theme %>">
  <head>
    <title>Varholl Garage Sale</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag 'application' %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg <%= current_theme == 'dark' ? 'navbar-dark' : 'navbar-light' %> mb-4 sticky-top">
      <div class="container align-items-center">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
          <%= image_tag "logo.png", alt: t('nav.brand'), height: 80 %>
        <% end %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto align-items-lg-center">
            <li class="nav-item">
              <%= link_to t('nav.cards'), cards_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to t('nav.bulk_search'), bulk_searches_path, class: "nav-link" %>
            </li>
            <li class="nav-item d-flex align-items-center">
              <%= link_to how_it_works_path, class: "btn btn-outline-light btn-sm" do %>
                <i class="fas fa-info-circle me-1"></i><%= t('nav.how_it_works') %>
              <% end %>
            </li>
          </ul>
          <ul class="navbar-nav align-items-lg-center flex-lg-row flex-wrap gap-1 mt-2 mt-lg-0 pt-2 pt-lg-0 navbar-icons-separator">
            <% if blue_dollar_rate %>
              <li class="nav-item d-flex align-items-center">
                <span class="btn btn-outline-light btn-sm" style="cursor: default; pointer-events: none;" title="<%= t('nav.blue_dollar_tooltip') %>" data-bs-toggle="tooltip">US$ = $<%= number_with_delimiter(blue_dollar_rate.round(0)) %></span>
              </li>
            <% end %>
            <li class="nav-item d-flex align-items-center">
              <select class="form-select form-select-sm" style="width: auto;" onchange="fetch(this.value, { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('meta[name=csrf-token]').content } }).then(() => window.location.reload())">
                <option value="<%= set_language_path(:es) %>" <%= 'selected' if I18n.locale == :es %>>ES</option>
                <option value="<%= set_language_path(:en) %>" <%= 'selected' if I18n.locale == :en %>>EN</option>
              </select>
            </li>
            <li class="nav-item d-flex align-items-center">
              <a href="#" class="nav-link" title="<%= current_theme == 'dark' ? t('nav.light_mode') : t('nav.dark_mode') %>" data-bs-toggle="tooltip" onclick="fetch('<%= toggle_theme_path %>', { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('meta[name=csrf-token]').content } }).then(() => window.location.reload()); return false;">
                <i class="fas <%= current_theme == 'dark' ? 'fa-sun' : 'fa-moon' %>"></i>
                <span class="d-lg-none ms-1"><%= current_theme == 'dark' ? t('nav.light_mode') : t('nav.dark_mode') %></span>
              </a>
            </li>
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to cart_items_path, class: "nav-link", title: t('nav.cart'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-shopping-cart"></i>
                  <span class="d-lg-none ms-1"><%= t('nav.cart') %></span>
                  <span id="cart_badge"><%= render "cart_items/badge" %></span>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to reservations_path, class: "nav-link", title: t('nav.my_reservations'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-clipboard-list"></i>
                  <span class="d-lg-none ms-1"><%= t('nav.my_reservations') %></span>
                <% end %>
              </li>
              <% if current_user.admin? %>
                <li class="nav-item">
                  <%= link_to admin_reservations_path, class: "nav-link", title: t('nav.admin'), data: { bs_toggle: "tooltip" } do %>
                    <i class="fas fa-shield-halved"></i>
                    <span class="d-lg-none ms-1"><%= t('nav.admin') %></span>
                  <% end %>
                </li>
              <% end %>
              <li class="nav-item">
                <%= link_to edit_profile_path, class: "nav-link", title: t('nav.profile'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-user-circle"></i>
                  <span class="d-lg-none ms-1"><%= t('nav.profile') %></span>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to destroy_user_session_path, data: { turbo_method: :delete, bs_toggle: "tooltip" }, class: "nav-link", title: t('nav.sign_out') do %>
                  <i class="fas fa-sign-out-alt"></i>
                  <span class="d-lg-none ms-1"><%= t('nav.sign_out') %></span>
                <% end %>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to new_user_session_path, class: "nav-link", title: t('nav.sign_in'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-sign-in-alt"></i>
                  <span class="d-lg-none ms-1"><%= t('nav.sign_in') %></span>
                <% end %>
              </li>
              <li class="nav-item">
                <%= link_to new_user_registration_path, class: "nav-link", title: t('nav.sign_up'), data: { bs_toggle: "tooltip" } do %>
                  <i class="fas fa-user-plus"></i>
                  <span class="d-lg-none ms-1"><%= t('nav.sign_up') %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
      <%= yield :mobile_search %>
    </nav>

    <% if maintenance_mode? %>
      <div class="maintenance-banner">
        <div class="container">
          <i class="fas fa-tools me-2"></i>
          <%= @maintenance_message.presence || t('maintenance.default_message') %>
        </div>
      </div>
    <% end %>

    <div class="container flex-grow-1 mb-5">
      <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
        <% if notice.present? %>
          <div class="toast align-items-center text-bg-success border-0" role="alert" data-controller="toast">
            <div class="d-flex">
              <div class="toast-body"><%= notice %></div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="toast align-items-center text-bg-danger border-0" role="alert" data-controller="toast">
            <div class="d-flex">
              <div class="toast-body"><%= alert %></div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
          </div>
        <% end %>
      </div>

      <%= render "shared/announcements" %>

      <%= yield %>
    </div>

    <footer class="mt-auto py-3 site-footer">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
            <span>&copy; <%= Date.today.year %> Varholl Garage Sale</span>
            <span class="opacity-75 ms-2"><%= t('footer.tagline') %></span>
          </div>
          <div class="col-md-6 text-center text-md-end">
            <a href="mailto:matias.laino@gmail.com" class="text-decoration-none me-3" style="color: var(--vg-text-muted);">
              <i class="fas fa-envelope" style="font-size: 18px;"></i>
            </a>
            <a href="https://www.instagram.com/varholl_mtg" target="_blank" rel="noopener noreferrer" class="text-decoration-none me-3" style="color: var(--vg-text-muted);">
              <i class="fab fa-instagram" style="font-size: 18px;"></i>
            </a>
            <a href="https://wa.me/5491163572143" target="_blank" rel="noopener noreferrer" class="text-decoration-none" style="color: var(--vg-text-muted);">
              <i class="fab fa-whatsapp" style="font-size: 18px;"></i>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el) {
          new bootstrap.Tooltip(el);
        });
      });
    </script>

    <% if user_signed_in? %>
      <%= link_to cart_items_path,
                  class: "mobile-cart-fab d-lg-none",
                  aria: { label: t('nav.cart') } do %>
        <i class="fas fa-shopping-cart"></i>
        <span id="mobile_cart_badge"><%= render "cart_items/badge" %></span>
      <% end %>
    <% end %>
  </body>
</html>
