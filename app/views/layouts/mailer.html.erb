<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        color: #e0e0e0;
        margin: 0;
        padding: 0;
        background-color: #0f0f23;
      }
      .email-wrapper {
        max-width: 600px;
        margin: 0 auto;
        background-color: #1a1a2e;
      }
      .email-header {
        background: linear-gradient(180deg, #0f0f23 0%, #1a1a2e 100%);
        border-bottom: 2px solid #a88832;
        color: #c9a84c;
        padding: 24px;
        text-align: center;
      }
      .email-header h1 {
        margin: 0;
        font-size: 22px;
        font-weight: bold;
        font-family: Georgia, 'Times New Roman', serif;
        letter-spacing: 0.05em;
      }
      .email-body {
        padding: 24px;
        color: #e0e0e0;
      }
      .email-body a {
        color: #5a8fba;
      }
      .email-footer {
        background-color: #0f0f23;
        border-top: 1px solid #2a3a5c;
        padding: 16px;
        text-align: center;
        font-size: 12px;
        color: #8a9bb5;
      }
      table.items-table {
        width: 100%;
        border-collapse: collapse;
        margin: 16px 0;
      }
      table.items-table th, table.items-table td {
        border: 1px solid #2a3a5c;
        padding: 8px;
        text-align: left;
        font-size: 13px;
      }
      table.items-table th {
        background-color: #1e2a45;
        color: #c9a84c;
        font-weight: bold;
      }
      table.items-table td {
        color: #e0e0e0;
      }
      .total-row {
        font-weight: bold;
        font-size: 15px;
        color: #c9a84c;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-header">
        <h1>Varholl Garage Sale</h1>
      </div>
      <div class="email-body">
        <%= yield %>
      </div>
      <div class="email-footer">
        Varholl Garage Sale
      </div>
    </div>
  </body>
</html>
