<h1 class="mb-4"><%= t('profiles.title') %></h1>

<div class="row">
  <div class="col-md-6">
    <%= form_with model: @user, url: profile_path, method: :patch do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <% @user.errors.full_messages.each do |msg| %>
            <p class="mb-0"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, t('profiles.name'), class: "form-label" %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :email, t('profiles.email'), class: "form-label" %>
        <%= f.email_field :email, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :phone_number, t('profiles.phone_number'), class: "form-label" %>
        <%= f.telephone_field :phone_number, class: "form-control" %>
      </div>

      <hr>
      <p class="text-muted"><%= t('profiles.password_hint') %></p>

      <div class="mb-3">
        <%= f.label :password, t('profiles.new_password'), class: "form-label" %>
        <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, t('profiles.password_confirmation'), class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.submit t('profiles.submit'), class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
