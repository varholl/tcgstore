<h2 class="mb-4"><%= t('devise_views.sign_in') %></h2>

<div class="row">
  <div class="col-md-6">
    <p class="text-muted mb-3"><%= t('devise_views.login_info') %></p>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-3">
        <%= f.label :email, t('devise_views.email'), class: "form-label" %>
        <%= f.email_field :email, class: "form-control", autofocus: true, autocomplete: "email" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, t('devise_views.password'), class: "form-label" %>
        <%= f.password_field :password, class: "form-control", autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-3 form-check">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, t('devise_views.remember_me'), class: "form-check-label" %>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.submit t('devise_views.sign_in'), class: "btn btn-primary" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>

  <%- if devise_mapping.omniauthable? %>
    <div class="col-md-1 d-flex align-items-center justify-content-center">
      <div class="vr h-100"></div>
    </div>
    <div class="col-md-5 d-flex align-items-center">
      <div class="w-100 text-center">
        <p class="text-muted mb-3"><%= t('devise_views.oauth_info') %></p>
        <%- resource_class.omniauth_providers.each do |provider| %>
          <%= button_to omniauth_authorize_path(resource_name, provider), method: :post, class: "btn btn-outline-dark btn-lg w-100", data: { turbo: false } do %>
            <i class="fab fa-google me-2"></i> <%= t('devise_views.sign_in_with', provider: "Google") %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
