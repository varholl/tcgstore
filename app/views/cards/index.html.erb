<h1 class="mb-4"><%= t('cards.title') %></h1>

<% if @show_how_it_works %>
  <div class="alert alert-info alert-dismissible fade show mb-4" role="alert"
       data-controller="dismiss-panel"
       data-dismiss-panel-url-value="<%= dismiss_how_it_works_cards_path %>">
    <h5 class="alert-heading"><i class="fas fa-info-circle"></i> <%= t('cards.how_it_works_panel.title') %></h5>
    <ol class="mb-2">
      <li><strong><%= t('pages.how_it_works.steps.step_1.title') %></strong> — <%= t('pages.how_it_works.steps.step_1.description') %></li>
      <li><strong><%= t('pages.how_it_works.steps.step_2.title') %></strong> — <%= t('pages.how_it_works.steps.step_2.description') %></li>
      <li><strong><%= t('pages.how_it_works.steps.step_3.title') %></strong> — <%= t('pages.how_it_works.steps.step_3.description') %></li>
      <li><strong><%= t('pages.how_it_works.steps.step_4.title') %></strong> — <%= t('pages.how_it_works.steps.step_4.description') %></li>
      <li><strong><%= t('pages.how_it_works.steps.step_5.title') %></strong> — <%= t('pages.how_it_works.steps.step_5.description') %></li>
    </ol>
    <button type="button" class="btn-close" aria-label="Close"
            data-action="dismiss-panel#dismiss"></button>
  </div>
<% end %>

<% new_arrivals_count = Card.where("quantity > 0").where("last_stocked_at >= ?", 7.days.ago).select(:edition, :collector_number, :condition, :language, :foil).distinct.count %>
<% if new_arrivals_count > 0 %>
  <div class="mb-3">
    <%= link_to cards_path(sort: "newest", view: @current_view), class: "btn btn-outline-success" do %>
      <i class="fas fa-sparkles"></i> <%= t('cards.new_arrivals', count: new_arrivals_count) %>
    <% end %>
  </div>
<% end %>

<%= form_tag cards_path, method: :get, class: "mb-4" do %>
  <div class="row g-2 mb-2">
    <div class="col">
      <div class="input-group">
        <%= text_field_tag :search, params[:search], class: "form-control", placeholder: t('cards.search_placeholder') %>
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> <%= t('cards.search') %></button>
      </div>
    </div>
  </div>
  <div class="row g-2">
    <div class="col-6 col-md-3">
      <%= select_tag :edition, options_for_select(Card.distinct.order(:edition_name).pluck(:edition_name, :edition), params[:edition]), include_blank: t('cards.all_editions'), class: "form-select form-select-sm", onchange: "this.form.submit()" %>
    </div>
    <div class="col-6 col-md-3">
      <%= select_tag :color, options_for_select(
        [
          [t('mtg_colors.W'), "W"],
          [t('mtg_colors.U'), "U"],
          [t('mtg_colors.B'), "B"],
          [t('mtg_colors.R'), "R"],
          [t('mtg_colors.G'), "G"],
          [t('mtg_colors.multicolor'), "multicolor"],
          [t('mtg_colors.colorless'), "colorless"]
        ], params[:color]), include_blank: t('cards.all_colors'), class: "form-select form-select-sm", onchange: "this.form.submit()" %>
    </div>
    <div class="col-6 col-md-3">
      <%= select_tag :card_type, options_for_select(
        Card.where.not(card_type: [nil, '']).distinct.order(:card_type).pluck(:card_type).map { |t_val| [t_val, t_val] },
        params[:card_type]), include_blank: t('cards.all_types'), class: "form-select form-select-sm", onchange: "this.form.submit()" %>
    </div>
    <div class="col-6 col-md-3">
      <%= select_tag :foil, options_for_select([[t('cards.foil_only'), "foil"], [t('cards.non_foil_only'), "non_foil"]], params[:foil]), include_blank: t('cards.all_cards'), class: "form-select form-select-sm", onchange: "this.form.submit()" %>
    </div>
  </div>
  <%= hidden_field_tag :view, @current_view %>
<% end %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
  <p class="text-muted mb-0">
    <%= t('cards.cards_found', count: @cards.total_count) %>
    <% if params[:search].present? || params[:edition].present? || params[:color].present? || params[:card_type].present? || params[:foil].present? %>
      <%= link_to cards_path(view: @current_view), class: "btn btn-outline-secondary btn-sm ms-2" do %>
        <i class="fas fa-filter-circle-xmark me-1"></i><%= t('cards.clear_all_filters') %>
      <% end %>
    <% end %>
  </p>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <div class="d-flex align-items-center gap-1">
      <label class="text-muted mb-0 d-flex align-items-center" for="sort_select">
        <i class="fas fa-arrow-down-short-wide"></i>
      </label>
      <%= select_tag :sort, options_for_select(CardsController::SORT_OPTIONS.map { |k, v| [t("cards.sort.#{k}"), k] }, @current_sort), id: "sort_select", class: "form-select form-select-sm", style: "width: auto;", onchange: "Turbo.visit('#{cards_path}?' + new URLSearchParams({...Object.fromEntries(new URLSearchParams(window.location.search)), sort: this.value}).toString(), { frame: 'cards-list' })" %>
    </div>
    <div class="btn-group" role="group">
      <%= link_to cards_path(request.query_parameters.merge(view: "list")), class: "btn btn-sm #{@current_view != 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
        </svg>
        <%= t('cards.list') %>
      <% end %>
      <%= link_to cards_path(request.query_parameters.merge(view: "grid")), class: "btn btn-sm #{@current_view == 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
        </svg>
        <%= t('cards.grid') %>
      <% end %>
    </div>
  </div>
</div>

<turbo-frame id="cards-list" data-turbo-action="advance" data-controller="scroll-top">
<% if @current_view == "grid" %>
  <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
    <% @cards.each do |card| %>
      <div class="col">
        <div class="card h-100<%= ' foil-card' if card.foil.present? %>" style="position: relative; overflow: hidden;">
          <% if card.last_stocked_at && card.last_stocked_at >= 7.days.ago %>
            <span class="new-arrival-badge"><%= t('cards.new_badge') %></span>
          <% end %>
          <img src="https://api.scryfall.com/cards/<%= card.edition %>/<%= card.collector_number %>?format=image&version=normal"
               class="card-img-top"
               alt="<%= card.name %>"
               loading="lazy"
               onerror="this.onerror=null;this.src='https://api.scryfall.com/cards/<%= card.edition %>/<%= card.collector_number %>?format=image&version=large';this.onerror=function(){this.style.display=\'none\'};">
          <div class="card-body p-2 d-flex flex-column">
            <div class="flex-grow-1">
              <h6 class="card-title mb-1"><%= card.name %></h6>
              <small class="text-muted"><%= card.edition_name || card.edition.upcase %> #<%= card.collector_number %></small>
              <div class="d-flex align-items-center flex-wrap gap-1 mt-1">
                <%= condition_badge(card.condition) %>
                <small><%= language_label(card.language) %></small>
                <% if card.foil.present? %>
                  <span class="badge" style="background-color: #d4a017;"><i class="fa-solid fa-star"></i> <%= card.foil_display %></span>
                <% end %>
              </div>
            </div>
            <div class="d-flex align-items-center justify-content-between mt-2">
              <div>
                <% if card.price %>
                  <strong class="text-price"><%= number_to_currency(card.price) %></strong>
                <% else %>
                  <small class="text-muted"><%= t('cards.no_price') %></small>
                <% end %>
              </div>
              <% available = @available_quantities[card.id] || 0 %>
              <small class="text-muted"><%= t('cards.qty') %>: <%= available %></small>
            </div>
          </div>
          <div class="card-footer p-2 d-flex gap-1">
            <div class="w-75">
              <% if available <= 0 %>
                <button class="btn btn-sm btn-secondary w-100" disabled title="<%= t('cards.out_of_stock') %>"><i class="fa-solid fa-ban"></i> <%= t('cards.out_of_stock') %></button>
              <% elsif maintenance_mode? %>
                <button class="btn btn-sm btn-secondary w-100" disabled><i class="fas fa-tools"></i> <%= t('cards.add_to_cart') %></button>
              <% elsif user_signed_in? %>
                <%= button_to cart_items_path(card_id: card.id), method: :post, class: "btn btn-sm btn-primary w-100", title: t('cards.add_to_cart') do %><i class="fa-solid fa-cart-plus"></i> <%= t('cards.add_to_cart') %><% end %>
              <% else %>
                <%= link_to t('cards.sign_in_to_buy'), new_user_session_path, class: "btn btn-sm btn-outline-primary w-100", data: { turbo: false } %>
              <% end %>
            </div>
            <% if card.scryfall_id.present? %>
              <%= link_to "https://scryfall.com/card/#{card.edition}/#{card.collector_number}", target: "_blank", rel: "noopener", title: t('cards.view_on_scryfall'), class: "btn btn-sm btn-scryfall w-25 d-flex align-items-center justify-content-center" do %><%= scryfall_icon %><% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <%# Mobile: stacked cards %>
  <div class="d-md-none d-flex flex-column gap-2">
    <% @cards.each do |card| %>
      <% available = @available_quantities[card.id] || 0 %>
      <div class="card<%= ' foil-card' if card.foil.present? %>">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <strong><%= card.name %></strong>
              <% if card.last_stocked_at && card.last_stocked_at >= 7.days.ago %>
                <span class="new-arrival-badge-inline"><%= t('cards.new_badge') %></span>
              <% end %>
              <br>
              <small class="text-muted"><%= card.edition_name || card.edition.upcase %> #<%= card.collector_number %></small>
            </div>
            <div class="text-end ms-2 text-nowrap">
              <% if card.price %>
                <strong class="text-price"><%= number_to_currency(card.price) %></strong>
              <% else %>
                <small class="text-muted"><%= t('cards.no_price') %></small>
              <% end %>
              <br>
              <small class="text-muted"><%= t('cards.qty') %>: <%= available %></small>
            </div>
          </div>
          <div class="d-flex align-items-center flex-wrap gap-1 mt-1">
            <%= condition_badge(card.condition) %>
            <small><%= language_label(card.language) %></small>
            <% if card.foil.present? %>
              <span class="badge" style="background-color: #d4a017;"><i class="fa-solid fa-star"></i> <%= card.foil_display %></span>
            <% end %>
          </div>
          <div class="d-flex gap-1 mt-2">
            <div class="w-75">
              <% if available <= 0 %>
                <button class="btn btn-sm btn-secondary w-100" disabled><i class="fa-solid fa-ban"></i> <%= t('cards.out_of_stock') %></button>
              <% elsif maintenance_mode? %>
                <button class="btn btn-sm btn-secondary w-100" disabled><i class="fas fa-tools"></i> <%= t('cards.add_to_cart') %></button>
              <% elsif user_signed_in? %>
                <%= button_to cart_items_path(card_id: card.id), method: :post, class: "btn btn-sm btn-primary w-100", title: t('cards.add_to_cart') do %><i class="fa-solid fa-cart-plus"></i> <%= t('cards.add_to_cart') %><% end %>
              <% else %>
                <%= link_to t('cards.sign_in_to_buy'), new_user_session_path, class: "btn btn-sm btn-outline-primary w-100", data: { turbo: false } %>
              <% end %>
            </div>
            <% if card.scryfall_id.present? %>
              <%= link_to "https://scryfall.com/card/#{card.edition}/#{card.collector_number}", target: "_blank", rel: "noopener", title: t('cards.view_on_scryfall'), class: "btn btn-sm btn-scryfall w-25 d-flex align-items-center justify-content-center" do %><%= scryfall_icon %><% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <%# Desktop: table %>
  <div class="d-none d-md-block table-responsive">
    <table class="table table-hover">
      <thead class="table-dark">
        <tr>
          <th><%= t('cards.name') %></th>
          <th><%= t('cards.edition') %></th>
          <th class="d-none d-lg-table-cell"><%= t('cards.condition') %></th>
          <th class="d-none d-lg-table-cell"><%= t('cards.language') %></th>
          <th class="d-none d-lg-table-cell"><%= t('cards.collector_number') %></th>
          <th><%= t('cards.price') %></th>
          <th><%= t('cards.qty') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @cards.each do |card| %>
          <tr>
            <td>
              <span class="d-inline-flex align-items-center gap-1">
                <%= card.name %>
                <% if card.last_stocked_at && card.last_stocked_at >= 7.days.ago %><span class="new-arrival-badge-inline"><%= t('cards.new_badge') %></span><% end %>
                <% if card.foil.present? %><i class="fa-solid fa-star" style="color: #d4a017;"></i> <span class="badge" style="background-color: #d4a017;"><%= card.foil_display %></span><% end %>
              </span>
            </td>
            <td><%= card.edition_name || card.edition.upcase %></td>
            <td class="d-none d-lg-table-cell"><%= condition_badge(card.condition) %></td>
            <td class="d-none d-lg-table-cell"><%= language_label(card.language) %></td>
            <td class="d-none d-lg-table-cell"><%= card.collector_number %></td>
            <td><%= card.price ? number_to_currency(card.price) : "—" %></td>
            <% available = @available_quantities[card.id] || 0 %>
            <td><%= available %></td>
            <td>
              <div class="d-flex align-items-center gap-1">
                <% if available <= 0 %>
                  <button class="btn btn-sm btn-secondary" disabled title="<%= t('cards.out_of_stock') %>"><i class="fa-solid fa-ban"></i> <%= t('cards.out_of_stock') %></button>
                <% elsif maintenance_mode? %>
                  <button class="btn btn-sm btn-secondary" disabled><i class="fas fa-tools"></i></button>
                <% elsif user_signed_in? %>
                  <%= button_to cart_items_path(card_id: card.id), method: :post, class: "btn btn-sm btn-primary", title: t('cards.add_to_cart') do %><i class="fa-solid fa-cart-plus"></i><% end %>
                <% else %>
                  <%= link_to t('cards.sign_in_to_buy'), new_user_session_path, class: "btn btn-sm btn-outline-primary" %>
                <% end %>
                <% if card.scryfall_id.present? %>
                  <%= link_to "https://scryfall.com/card/#{card.edition}/#{card.collector_number}", target: "_blank", rel: "noopener", title: t('cards.view_on_scryfall'), class: "btn btn-sm btn-scryfall d-flex align-items-center" do %><%= scryfall_icon %><% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<div class="mt-4"><%= paginate @cards %></div>
</turbo-frame>
