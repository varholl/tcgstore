<%= render layout: 'layouts/admin_sidebar' do %>
<div class="mb-4">
  <h1><%= t('admin.stock_reconciliations.result_title') %></h1>
</div>

<div class="alert alert-success">
  <h5><%= t("admin.stock_reconciliations.mode_#{@mode}") %></h5>
  <ul class="mb-0">
    <li><strong><%= @result.cards_created %></strong> <%= t('admin.stock_reconciliations.cards_created') %></li>
    <li><strong><%= @result.cards_updated %></strong> <%= t('admin.stock_reconciliations.cards_updated') %></li>
    <li><strong><%= @result.cards_unchanged %></strong> <%= t('admin.stock_reconciliations.cards_unchanged') %></li>
    <% if @mode == :full %>
      <li><strong><%= @result.cards_zeroed %></strong> <%= t('admin.stock_reconciliations.cards_zeroed') %></li>
    <% end %>
  </ul>
</div>

<% if @result.reservation_conflicts.any? %>
  <div class="alert alert-warning">
    <h5><i class="fas fa-exclamation-triangle me-1"></i> <%= t('admin.stock_reconciliations.reservation_conflicts_title') %></h5>
    <p><%= t('admin.stock_reconciliations.reservation_conflicts_warning') %></p>
    <table class="table table-sm table-bordered mb-0">
      <thead>
        <tr>
          <th><%= t('admin.stock_reconciliations.card_name') %></th>
          <th><%= t('admin.stock_reconciliations.edition') %></th>
          <th><%= t('admin.stock_reconciliations.collector_number') %></th>
          <th><%= t('admin.stock_reconciliations.reserved_quantity') %></th>
          <th><%= t('admin.stock_reconciliations.reservations') %></th>
        </tr>
      </thead>
      <tbody>
        <% @result.reservation_conflicts.each do |conflict| %>
          <tr>
            <td><%= conflict[:card].name %></td>
            <td><%= conflict[:card].edition.upcase %></td>
            <td><%= conflict[:card].collector_number %></td>
            <td><%= conflict[:reserved_quantity] %></td>
            <td>
              <% conflict[:reservation_ids].each do |rid| %>
                <%= link_to "##{rid}", admin_reservation_path(rid), class: "badge bg-warning text-dark text-decoration-none" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%= link_to t('admin.stock_reconciliations.back'), new_admin_stock_reconciliation_path, class: "btn btn-outline-secondary" %>
<% end %>
