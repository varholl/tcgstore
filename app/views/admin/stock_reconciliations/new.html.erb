<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('admin.stock_reconciliations.title') %></h1>
  <%= link_to export_admin_stock_reconciliations_path, class: "btn btn-outline-secondary" do %>
    <i class="fas fa-download me-1"></i> <%= t('admin.stock_reconciliations.export') %>
  <% end %>
</div>

<div class="card">
  <div class="card-body">
    <%= form_tag admin_stock_reconciliations_path, method: :post, multipart: true, data: { turbo: false, controller: "stock-reconciliation-form" } do %>
      <div class="mb-3">
        <label class="form-label"><%= t('admin.stock_reconciliations.format_label') %></label>
        <div class="form-check">
          <%= radio_button_tag :format_type, "moxfield", false, class: "form-check-input", id: "format_moxfield", data: { action: "stock-reconciliation-form#toggleFormat", stock_reconciliation_form_target: "formatRadio" } %>
          <label class="form-check-label" for="format_moxfield">
            <strong>Moxfield</strong>
          </label>
        </div>
        <div class="form-check mt-2">
          <%= radio_button_tag :format_type, "manabox", true, class: "form-check-input", id: "format_manabox", data: { action: "stock-reconciliation-form#toggleFormat", stock_reconciliation_form_target: "formatRadio" } %>
          <label class="form-check-label" for="format_manabox">
            <strong>ManaBox</strong>
          </label>
          <div class="form-text"><%= t('admin.stock_reconciliations.manabox_hint') %></div>
        </div>
      </div>

      <div class="mb-3">
        <%= label_tag :seller_id, t('admin.stock_reconciliations.seller_label'), class: "form-label" %>
        <%= select_tag :seller_id, options_from_collection_for_select(@sellers, :id, :name, Seller.default&.id), class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= label_tag :file, t('admin.stock_reconciliations.upload_label'), class: "form-label" %>
        <%= file_field_tag :file, accept: ".csv", class: "form-control" %>
      </div>

      <div class="mb-3" data-stock-reconciliation-form-target="modeSection" style="display: none;">
        <label class="form-label"><%= t('admin.stock_reconciliations.mode_label') %></label>
        <div class="form-check">
          <%= radio_button_tag :mode, "full", false, class: "form-check-input", id: "mode_full" %>
          <label class="form-check-label" for="mode_full">
            <strong><%= t('admin.stock_reconciliations.full_mode') %></strong>
          </label>
          <div class="form-text"><%= t('admin.stock_reconciliations.full_mode_hint') %></div>
        </div>
        <div class="form-check mt-2">
          <%= radio_button_tag :mode, "partial", true, class: "form-check-input", id: "mode_partial" %>
          <label class="form-check-label" for="mode_partial">
            <strong><%= t('admin.stock_reconciliations.partial_mode') %></strong>
          </label>
          <div class="form-text"><%= t('admin.stock_reconciliations.partial_mode_hint') %></div>
        </div>
      </div>

      <div class="mb-3">
        <div class="form-check">
          <%= check_box_tag :preorder, "1", false, class: "form-check-input", id: "preorder_check",
              data: { stock_reconciliation_form_target: "preorderCheckbox", action: "stock-reconciliation-form#togglePreorder" } %>
          <label class="form-check-label" for="preorder_check">
            <strong><%= t('admin.stock_reconciliations.preorder_label') %></strong>
          </label>
          <div class="form-text"><%= t('admin.stock_reconciliations.preorder_hint') %></div>
        </div>
        <div class="mt-2" data-stock-reconciliation-form-target="preorderSection" style="display: none;">
          <label class="form-label"><%= t('admin.cards.release_date') %></label>
          <input type="text" name="release_date" class="form-control" style="max-width: 250px;" data-controller="flatpickr">
        </div>
      </div>

      <%= submit_tag t('admin.stock_reconciliations.submit'), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
<% end %>
