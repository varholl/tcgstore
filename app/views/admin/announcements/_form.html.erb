<% if @announcement.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @announcement.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="mb-3">
  <%= f.label :title, t('admin.announcements.title_label'), class: "form-label" %>
  <%= f.text_field :title, class: "form-control" %>
  <div class="form-text"><%= t('admin.announcements.title_hint') %></div>
</div>

<div class="mb-3">
  <%= f.label :body, t('admin.announcements.body_label'), class: "form-label" %>
  <%= f.text_area :body, class: "form-control", rows: 3, required: true %>
</div>

<div class="mb-3">
  <%= f.label :level, t('admin.announcements.level'), class: "form-label" %>
  <%= f.select :level, Announcement::LEVELS.map { |l| [t("admin.announcements.levels.#{l}"), l] }, {}, class: "form-select" %>
  <div class="form-text"><%= t('admin.announcements.level_hint') %></div>
</div>

<div class="row">
  <div class="col-md-6 mb-3">
    <%= f.label :starts_at, t('admin.announcements.starts_at'), class: "form-label" %>
    <%= f.text_field :starts_at, value: @announcement.starts_at&.strftime("%Y-%m-%d %H:%M"), class: "form-control", data: { controller: "flatpickr" } %>
  </div>
  <div class="col-md-6 mb-3">
    <%= f.label :ends_at, t('admin.announcements.ends_at'), class: "form-label" %>
    <%= f.text_field :ends_at, value: @announcement.ends_at&.strftime("%Y-%m-%d %H:%M"), class: "form-control", data: { controller: "flatpickr" } %>
  </div>
</div>
<div class="form-text mb-3"><%= t('admin.announcements.schedule_hint') %></div>

<div class="mb-3 form-check">
  <%= f.check_box :active, class: "form-check-input" %>
  <%= f.label :active, t('admin.announcements.active_label'), class: "form-check-label" %>
</div>
