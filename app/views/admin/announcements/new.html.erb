<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('admin.announcements.new_title') %></h1>
  <%= link_to t('admin.announcements.back'), admin_announcements_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card">
  <div class="card-body">
    <%= form_with model: [:admin, @announcement] do |f| %>
      <%= render "form", f: f %>
      <%= f.submit t('admin.announcements.create'), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
<% end %>
