<%= render layout: 'layouts/admin_sidebar' do %>
<div class="mb-4">
  <h1><%= t('admin.site_settings.title') %></h1>
</div>

<div class="card">
  <div class="card-body">
    <%= form_with model: @site_setting, url: admin_site_settings_path, method: :patch do |f| %>
      <div class="mb-3">
        <div class="form-check form-switch">
          <%= f.check_box :maintenance_mode, class: "form-check-input", role: "switch", id: "maintenance_mode" %>
          <label class="form-check-label" for="maintenance_mode">
            <strong><%= t('admin.site_settings.maintenance_mode_label') %></strong>
          </label>
        </div>
        <div class="form-text"><%= t('admin.site_settings.maintenance_mode_hint') %></div>
      </div>

      <div class="mb-3">
        <%= f.label :maintenance_message, t('admin.site_settings.message_label'), class: "form-label" %>
        <%= f.text_area :maintenance_message, class: "form-control", rows: 3, placeholder: t('admin.site_settings.message_placeholder') %>
        <div class="form-text"><%= t('admin.site_settings.message_hint') %></div>
      </div>

      <% if @site_setting.maintenance_mode? %>
        <div class="alert alert-warning mb-3">
          <i class="fas fa-exclamation-triangle me-1"></i>
          <%= t('admin.site_settings.maintenance_active_warning') %>
        </div>
      <% end %>

      <%= f.submit t('admin.site_settings.save'), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
<% end %>
