<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('admin.users.title') %></h1>
</div>

<%= form_tag admin_users_path, method: :get, class: "mb-4" do %>
  <div class="input-group">
    <%= text_field_tag :search, params[:search], class: "form-control", placeholder: t('admin.users.search_placeholder') %>
    <button class="btn btn-outline-primary" type="submit"><%= t('admin.users.search') %></button>
    <% if params[:search].present? %>
      <%= link_to t('admin.users.clear'), admin_users_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>

<% if @users.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th><%= t('admin.users.name') %></th>
          <th><%= t('admin.users.email') %></th>
          <th><%= t('admin.users.phone') %></th>
          <th><%= t('admin.users.reservations_count') %></th>
          <th><%= t('admin.users.joined') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td><%= user.phone_number %></td>
            <td><%= user.reservations.count %></td>
            <td><%= user.created_at.strftime("%b %d, %Y") %></td>
            <td>
              <div class="d-flex gap-1">
                <%= link_to admin_user_path(user), class: "btn btn-sm btn-outline-primary", title: t('admin.users.view') do %><i class="fas fa-eye"></i><% end %>
                <%= link_to edit_admin_user_path(user), class: "btn btn-sm btn-outline-secondary", title: t('admin.users.edit') do %><i class="fas fa-pencil"></i><% end %>
                <%= button_to admin_user_path(user), method: :delete, class: "btn btn-sm btn-outline-danger", title: t('admin.users.delete'), form_class: "d-inline", data: { turbo_confirm: t('admin.users.delete_confirm') } do %><i class="fas fa-trash"></i><% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @users %>
<% else %>
  <div class="alert alert-info"><%= t('admin.users.no_users') %></div>
<% end %>
<% end %>
