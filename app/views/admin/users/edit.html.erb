<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('admin.users.edit_title') %></h1>
  <%= link_to t('admin.users.back_to_user'), admin_user_path(@user), class: "btn btn-outline-secondary" %>
</div>

<%= form_with(model: @user, url: admin_user_path(@user), method: :patch) do |f| %>
  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, t('admin.users.form_name'), class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :email, t('admin.users.form_email'), class: "form-label" %>
    <%= f.email_field :email, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :phone_number, t('admin.users.form_phone'), class: "form-label" %>
    <%= f.text_field :phone_number, class: "form-control" %>
  </div>

  <%= f.submit t('admin.users.submit'), class: "btn btn-primary" %>
<% end %>
<% end %>
