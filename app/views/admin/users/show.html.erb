<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= @user.name %></h1>
  <%= link_to t('admin.users.back'), admin_users_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <h5><%= t('admin.users.user_info') %></h5>
    <p><strong><%= t('admin.users.name_label') %></strong> <%= @user.name %></p>
    <p><strong><%= t('admin.users.email_label') %></strong> <%= @user.email %></p>
    <p><strong><%= t('admin.users.phone_label') %></strong> <%= @user.phone_number || t('admin.users.na') %></p>
    <p><strong><%= t('admin.users.dni_label') %></strong> <%= @user.dni || t('admin.users.na') %></p>
    <p><strong><%= t('admin.users.joined_label') %></strong> <%= @user.created_at.in_time_zone.strftime("%d/%m/%Y") %></p>
    <p><strong><%= t('admin.users.status') %>:</strong>
      <% if @user.confirmed? %>
        <span class="badge bg-success"><%= t('admin.users.active') %></span>
      <% else %>
        <span class="badge bg-secondary"><%= t('admin.users.inactive') %></span>
      <% end %>
    </p>
    <% addr = @user.addresses.first %>
    <% if addr&.address.present? %>
      <hr>
      <h6><%= t('admin.users.address_title') %></h6>
      <p><%= [addr.address, addr.address_number].compact_blank.join(" ") %></p>
      <p><%= [addr.city, addr.province.present? ? t("reservations.shipping_info.provinces.#{addr.province}", default: addr.province) : nil, addr.zipcode].compact_blank.join(", ") %></p>
      <% if addr.between_streets.present? %>
        <p><small class="text-muted"><%= t('reservations.shipping_info.between_streets') %>: <%= addr.between_streets %></small></p>
      <% end %>
    <% end %>
  </div>
</div>

<div class="d-flex gap-2 mb-4">
  <% unless @user.confirmed? %>
    <%= button_to t('admin.users.activate'), activate_admin_user_path(@user), method: :patch, class: "btn btn-success" %>
  <% end %>
  <%= link_to t('admin.users.edit'), edit_admin_user_path(@user), class: "btn btn-primary" %>
  <%= button_to t('admin.users.delete'), admin_user_path(@user), method: :delete, class: "btn btn-danger", data: { turbo_confirm: t('admin.users.delete_confirm') } %>
</div>

<% unpaid_reservations = @reservations.select { |r| r.pending? || r.prepared? } %>
<% if unpaid_reservations.any? %>
  <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">
    <div>
      <strong><%= t('admin.users.unpaid_balance') %></strong>
      <small class="text-muted ms-2">(<%= unpaid_reservations.size %> <%= t('admin.users.unpaid_reservations_count') %>)</small>
    </div>
    <h4 class="mb-0"><%= number_to_currency(unpaid_reservations.sum(&:total_price)) %></h4>
  </div>
<% end %>

<h4><%= t('admin.users.reservations_title') %></h4>

<% if @reservations.any? %>
  <div class="table-responsive">
    <table class="table table-striped admin-mobile-table">
      <thead class="table-dark">
        <tr>
          <th><%= t('admin.users.reservation_date') %></th>
          <th><%= t('admin.users.items_count') %></th>
          <th><%= t('admin.users.total') %></th>
          <th><%= t('admin.users.status') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% status_colors = { "pending" => "warning", "in_preparation" => "warning-subtle text-warning-emphasis", "prepared" => "primary", "paid" => "info", "shipped" => "dark", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
        <% @reservations.each do |reservation| %>
          <tr>
            <td data-label="<%= t('admin.users.reservation_date') %>"><%= reservation.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></td>
            <td data-label="<%= t('admin.users.items_count') %>"><%= reservation.reservation_items.sum(:quantity) %></td>
            <td data-label="<%= t('admin.users.total') %>"><%= number_to_currency(reservation.total_price) %></td>
            <td data-label="<%= t('admin.users.status') %>">
              <span class="badge bg-<%= status_colors[reservation.status] %>"><%= t("statuses.#{reservation.status}") %></span>
            </td>
            <td data-label="">
              <%= link_to admin_reservation_path(reservation), class: "btn btn-sm btn-outline-primary", title: t('admin.users.view_reservation') do %><i class="fas fa-eye"></i><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info"><%= t('admin.users.no_reservations') %></div>
<% end %>
<% end %>
