<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= @user.name %></h1>
  <%= link_to t('admin.users.back'), admin_users_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <h5><%= t('admin.users.user_info') %></h5>
    <p><strong><%= t('admin.users.name_label') %></strong> <%= @user.name %></p>
    <p><strong><%= t('admin.users.email_label') %></strong> <%= @user.email %></p>
    <p><strong><%= t('admin.users.phone_label') %></strong> <%= @user.phone_number || t('admin.users.na') %></p>
    <p><strong><%= t('admin.users.joined_label') %></strong> <%= @user.created_at.strftime("%b %d, %Y") %></p>
  </div>
</div>

<div class="d-flex gap-2 mb-4">
  <%= link_to t('admin.users.edit'), edit_admin_user_path(@user), class: "btn btn-primary" %>
  <%= button_to t('admin.users.delete'), admin_user_path(@user), method: :delete, class: "btn btn-danger", data: { turbo_confirm: t('admin.users.delete_confirm') } %>
</div>

<h4><%= t('admin.users.reservations_title') %></h4>

<% if @reservations.any? %>
  <div class="table-responsive">
    <table class="table table-striped">
      <thead class="table-dark">
        <tr>
          <th><%= t('admin.users.reservation_date') %></th>
          <th><%= t('admin.users.items_count') %></th>
          <th><%= t('admin.users.status') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @reservations.each do |reservation| %>
          <tr>
            <td><%= reservation.created_at.strftime("%b %d, %Y %H:%M") %></td>
            <td><%= reservation.reservation_items.sum(:quantity) %></td>
            <td>
              <% status_colors = { "pending" => "warning", "paid" => "info", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
              <span class="badge bg-<%= status_colors[reservation.status] %>"><%= t("statuses.#{reservation.status}") %></span>
            </td>
            <td>
              <%= link_to admin_reservation_path(reservation), class: "btn btn-sm btn-outline-primary", title: t('admin.users.view_reservation') do %><i class="fas fa-eye"></i><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info"><%= t('admin.users.no_reservations') %></div>
<% end %>
<% end %>
