<% if cards.any? %>
  <table class="table table-sm table-striped">
    <thead>
      <tr>
        <th><%= t('admin.reservations.card_name') %></th>
        <th><%= t('admin.reservations.edition') %></th>
        <th><%= t('admin.reservations.condition') %></th>
        <th><%= t('admin.reservations.price') %></th>
        <th><%= t('admin.reservations.available') %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% cards.each do |card| %>
        <% available = card.available_quantity %>
        <tr>
          <td><%= card.name %></td>
          <td><%= card.edition_name || card.edition.upcase %></td>
          <td><%= card.condition %></td>
          <td><%= card.price ? number_to_currency(card.price) : "—" %></td>
          <td><%= available %></td>
          <td>
            <% if available > 0 %>
              <button type="button" class="btn btn-sm btn-success"
                      data-action="click->walk-in-search#sell"
                      data-card-id="<%= card.id %>">
                <i class="fas fa-cash-register me-1"></i><%= t('admin.dashboard.walk_in.sell') %>
              </button>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted"><%= t('admin.reservations.no_cards_found') %></p>
<% end %>
