<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('admin.cards.title') %></h1>
  <div class="d-flex gap-2">
    <%= button_to refresh_prices_admin_cards_path, method: :post, class: "btn btn-outline-success", form: { data: { turbo_confirm: t('admin.cards.refresh_prices_confirm') } } do %>
      <i class="fas fa-sync me-1"></i> <%= t('admin.cards.refresh_prices') %>
    <% end %>
    <%= link_to new_admin_card_path, class: "btn btn-primary" do %>
      <i class="fas fa-plus me-1"></i> <%= t('admin.cards.add_card') %>
    <% end %>
  </div>
</div>

<%= form_tag admin_cards_path, method: :get, class: "mb-4" do %>
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <%= text_field_tag :search, params[:search], class: "form-control", placeholder: t('admin.cards.search_placeholder') %>
    </div>
    <div class="col-md-2">
      <%= select_tag :edition, options_for_select(Card.distinct.order(:edition_name).pluck(:edition_name, :edition), params[:edition]), include_blank: t('admin.cards.all_editions'), class: "form-select" %>
    </div>
    <div class="col-md-2">
      <%= select_tag :price_source, options_for_select([[t('admin.cards.needs_price_review'), "needs_review"], [t('admin.cards.price_source_scryfall'), "scryfall"], [t('admin.cards.price_source_card_kingdom'), "card_kingdom"]], params[:price_source]), include_blank: t('admin.cards.all_price_sources'), class: "form-select" %>
    </div>
    <div class="col-md-2">
      <div class="form-check">
        <%= check_box_tag :no_price, "1", params[:no_price] == "1", class: "form-check-input", id: "no_price" %>
        <label class="form-check-label" for="no_price"><%= t('admin.cards.no_price') %></label>
      </div>
    </div>
    <div class="col-auto">
      <button class="btn btn-outline-primary" type="submit"><%= t('admin.cards.search') %></button>
      <% if params[:search].present? || params[:edition].present? || params[:no_price].present? || params[:sort].present? || params[:price_source].present? %>
        <%= link_to t('admin.cards.clear'), admin_cards_path, class: "btn btn-outline-secondary ms-1" %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <p class="text-muted mb-0"><%= t('admin.cards.cards_found', count: @cards.total_count) %></p>
  <div class="d-flex align-items-center gap-2">
    <label class="text-muted mb-0 d-flex align-items-center gap-1" for="sort_select">
      <i class="fas fa-arrow-down-short-wide"></i>
    </label>
    <%= select_tag :sort, options_for_select(Admin::CardsController::SORT_OPTIONS.map { |k, _| [t("admin.cards.sort.#{k}"), k] }, @current_sort), id: "sort_select", class: "form-select form-select-sm", style: "width: auto;", onchange: "window.location.href='#{admin_cards_path}?' + new URLSearchParams({...Object.fromEntries(new URLSearchParams(window.location.search)), sort: this.value}).toString()" %>
  </div>
</div>

<% if @cards.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th><%= t('admin.cards.name') %></th>
          <th><%= t('admin.cards.edition') %></th>
          <th><%= t('admin.cards.collector_number') %></th>
          <th><%= t('admin.cards.condition') %></th>
          <th><%= t('admin.cards.language') %></th>
          <th><%= t('admin.cards.foil') %></th>
          <th><%= t('admin.cards.quantity') %></th>
          <th><%= t('admin.cards.price') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @cards.each do |card| %>
          <tr>
            <td><%= card.name %></td>
            <td><%= card.edition_name %></td>
            <td><%= card.collector_number %></td>
            <td><%= card.condition %></td>
            <td><%= card.language %></td>
            <td><% if card.foil.present? %><span class="badge bg-info"><%= t('admin.cards.foil') %></span><% end %></td>
            <td><%= card.quantity %></td>
            <td>
              <%= card.price ? number_to_currency(card.price) : "—" %>
              <% if card.price_source == "scryfall" && !card.price_reviewed? %>
                <span class="badge bg-warning text-dark" title="<%= t('admin.cards.price_from_scryfall') %>"><i class="fas fa-exclamation-triangle"></i></span>
                <%= button_to mark_price_reviewed_admin_card_path(card), method: :patch, class: "btn btn-sm btn-outline-success p-0 px-1", title: t('admin.cards.mark_reviewed') do %><i class="fas fa-check"></i><% end %>
              <% end %>
            </td>
            <td>
              <%= link_to edit_admin_card_path(card), class: "btn btn-sm btn-outline-secondary", title: t('admin.cards.edit') do %><i class="fas fa-pencil"></i><% end %>
              <%= button_to admin_card_path(card), method: :delete, class: "btn btn-sm btn-outline-danger", title: t('admin.cards.delete'), form: { data: { turbo_confirm: t('admin.cards.delete_confirm') } } do %><i class="fas fa-trash"></i><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @cards %>
<% else %>
  <div class="alert alert-info"><%= t('admin.cards.no_cards') %></div>
<% end %>
<% end %>
