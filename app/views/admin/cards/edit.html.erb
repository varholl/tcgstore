<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('admin.cards.edit_title') %></h1>
  <%= link_to t('admin.cards.back'), "javascript:history.back()", class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <h5 class="card-title"><%= t('admin.cards.card_info') %></h5>
    <dl class="row mb-0">
      <dt class="col-sm-3"><%= t('admin.cards.name') %></dt>
      <dd class="col-sm-9"><%= @card.name %></dd>

      <dt class="col-sm-3"><%= t('admin.cards.edition') %></dt>
      <dd class="col-sm-9"><%= @card.edition_name %></dd>

      <dt class="col-sm-3"><%= t('admin.cards.collector_number') %></dt>
      <dd class="col-sm-9"><%= @card.collector_number %></dd>

      <dt class="col-sm-3"><%= t('admin.cards.condition') %></dt>
      <dd class="col-sm-9"><%= @card.condition %></dd>

      <dt class="col-sm-3"><%= t('admin.cards.language') %></dt>
      <dd class="col-sm-9"><%= @card.language %></dd>

      <dt class="col-sm-3"><%= t('admin.cards.foil') %></dt>
      <dd class="col-sm-9"><%= @card.foil.present? ? "Yes" : "No" %></dd>

      <dt class="col-sm-3">Scryfall ID</dt>
      <dd class="col-sm-9"><%= @card.scryfall_id %></dd>
    </dl>
  </div>
</div>

<%= form_with(model: @card, url: admin_card_path(@card), method: :patch) do |f| %>
  <%= hidden_field_tag :return_to, @return_to %>
  <% if @card.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @card.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @pending_reserved > 0 %>
    <div class="alert alert-warning">
      <i class="fas fa-exclamation-triangle me-1"></i>
      <%= t('admin.cards.pending_reserved_warning', count: @pending_reserved, available: @card.available_quantity) %>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :quantity, t('admin.cards.quantity'), class: "form-label" %>
        <%= f.number_field :quantity, min: 0, class: "form-control" %>
        <% if @pending_reserved > 0 %>
          <div class="form-text text-warning">
            <%= t('admin.cards.pending_reserved_hint', count: @pending_reserved) %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :price, t('admin.cards.price'), class: "form-label" %>
        <%= f.number_field :price, min: 0, step: 0.01, class: "form-control" %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="form-check mt-4 pt-2">
        <%= f.check_box :foil, { class: "form-check-input", checked: @card.foil.present? }, "Yes", "" %>
        <%= f.label :foil, t('admin.cards.foil'), class: "form-check-label" %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :condition, t('admin.cards.condition'), class: "form-label" %>
        <%= f.select :condition, %w[NM LP MP HP DMG], {}, class: "form-select" %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :language, t('admin.cards.language'), class: "form-label" %>
        <%= f.select :language, %w[English Spanish Japanese Italian Portuguese].map { |l| [t("languages.#{l.downcase}"), l] }, {}, class: "form-select" %>
      </div>
    </div>
  </div>

  <%= f.submit t('admin.cards.update_card'), class: "btn btn-primary" %>
<% end %>
<% end %>
