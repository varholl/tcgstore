<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4 admin-header-actions">
  <h1><%= t('admin.sellers.title') %></h1>
  <%= link_to t('admin.sellers.new_seller'), new_admin_seller_path, class: "btn btn-primary" %>
</div>

<% if @sellers.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover admin-mobile-table">
      <thead class="table-dark">
        <tr>
          <th><%= t('admin.sellers.name') %></th>
          <th><%= t('admin.sellers.email') %></th>
          <th><%= t('admin.sellers.cards_count') %></th>
          <th><%= t('admin.sellers.linked_user') %></th>
          <th><%= t('admin.sellers.default') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @sellers.each do |seller| %>
          <tr>
            <td data-label="<%= t('admin.sellers.name') %>"><%= seller.name %></td>
            <td data-label="<%= t('admin.sellers.email') %>"><%= seller.email || "—" %></td>
            <td data-label="<%= t('admin.sellers.cards_count') %>"><%= seller.cards.where("quantity > 0").count %></td>
            <td data-label="<%= t('admin.sellers.linked_user') %>"><%= seller.user&.name || seller.user&.email || "—" %></td>
            <td data-label="<%= t('admin.sellers.default') %>">
              <% if seller.default? %>
                <span class="badge bg-success"><%= t('admin.sellers.yes') %></span>
              <% end %>
            </td>
            <td data-label="">
              <div class="d-flex gap-1">
                <%= link_to edit_admin_seller_path(seller), class: "btn btn-sm btn-outline-secondary", title: t('admin.sellers.edit') do %><i class="fas fa-pencil"></i><% end %>
                <% unless seller.default? %>
                  <%= button_to admin_seller_path(seller), method: :delete, class: "btn btn-sm btn-outline-danger", title: t('admin.sellers.delete'), form_class: "d-inline", data: { turbo_confirm: t('admin.sellers.delete_confirm') } do %><i class="fas fa-trash"></i><% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info"><%= t('admin.sellers.no_sellers') %></div>
<% end %>
<% end %>
