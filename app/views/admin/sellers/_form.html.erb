<div class="mb-3">
  <%= f.label :name, t('admin.sellers.name'), class: "form-label" %>
  <%= f.text_field :name, class: "form-control", required: true %>
</div>

<div class="mb-3">
  <%= f.label :email, t('admin.sellers.email'), class: "form-label" %>
  <%= f.text_field :email, class: "form-control" %>
  <div class="form-text"><%= t('admin.sellers.email_hint') %></div>
</div>

<div class="mb-3">
  <%= f.label :user_id, t('admin.sellers.linked_user'), class: "form-label" %>
  <%= f.select :user_id, User.order(:name).map { |u| ["#{u.name} (#{u.email})", u.id] }, { include_blank: t('admin.sellers.no_linked_user') }, class: "form-select" %>
  <div class="form-text"><%= t('admin.sellers.linked_user_hint') %></div>
</div>

<div class="mb-3 form-check">
  <%= f.check_box :default, class: "form-check-input" %>
  <%= f.label :default, t('admin.sellers.mark_as_default'), class: "form-check-label" %>
</div>
