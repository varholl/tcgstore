<%= render layout: 'layouts/admin_sidebar' do %>
<h1 class="mb-4"><%= t('admin.reservations.new_title') %></h1>

<%= form_with url: admin_reservations_path, method: :post, local: true,
     data: { controller: "admin-card-selector", search_url: search_cards_admin_reservations_path } do |f| %>

  <div class="card mb-4">
    <div class="card-body">
      <h5><%= t('admin.reservations.customer_type') %></h5>

      <div class="form-check form-check-inline mb-3">
        <input type="radio" name="customer_type" value="existing" id="customer_existing"
               class="form-check-input" checked
               data-action="change->admin-card-selector#toggleCustomerType">
        <label class="form-check-label" for="customer_existing"><%= t('admin.reservations.existing_user') %></label>
      </div>
      <div class="form-check form-check-inline mb-3">
        <input type="radio" name="customer_type" value="guest" id="customer_guest"
               class="form-check-input"
               data-action="change->admin-card-selector#toggleCustomerType">
        <label class="form-check-label" for="customer_guest"><%= t('admin.reservations.guest') %></label>
      </div>

      <div data-admin-card-selector-target="userFields">
        <div class="mb-3">
          <label for="reservation_user_id" class="form-label"><%= t('admin.reservations.select_user') %></label>
          <select name="reservation[user_id]" id="reservation_user_id" class="form-select">
            <option value=""></option>
            <% @users.each do |user| %>
              <option value="<%= user.id %>"><%= user.name %> (<%= user.email %>)</option>
            <% end %>
          </select>
        </div>
      </div>

      <div data-admin-card-selector-target="guestFields" class="d-none">
        <div class="mb-3">
          <label for="reservation_guest_name" class="form-label"><%= t('admin.reservations.guest_name_label') %></label>
          <input type="text" name="reservation[guest_name]" id="reservation_guest_name" class="form-control">
        </div>
        <div class="mb-3">
          <label for="reservation_guest_contact" class="form-label"><%= t('admin.reservations.guest_contact_label') %></label>
          <input type="text" name="reservation[guest_contact]" id="reservation_guest_contact" class="form-control">
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h5><%= t('admin.reservations.select_cards') %></h5>

      <div class="input-group mb-3">
        <input type="text" class="form-control"
               placeholder="<%= t('admin.reservations.search_cards_placeholder') %>"
               data-admin-card-selector-target="searchInput">
        <button type="button" class="btn btn-outline-primary"
                data-action="click->admin-card-selector#search">
          <%= t('admin.reservations.search') %>
        </button>
      </div>

      <div data-admin-card-selector-target="searchResults"></div>

      <div data-admin-card-selector-target="selectedCards" class="d-none mt-4">
        <h6><%= t('admin.reservations.selected_cards') %></h6>
        <table class="table table-sm">
          <thead>
            <tr>
              <th><%= t('admin.reservations.card_name') %></th>
              <th><%= t('admin.reservations.edition') %></th>
              <th><%= t('admin.reservations.condition') %></th>
              <th><%= t('admin.reservations.quantity') %></th>
              <th></th>
            </tr>
          </thead>
          <tbody data-admin-card-selector-target="selectedCardsBody"></tbody>
        </table>
      </div>

      <div data-admin-card-selector-target="itemsContainer"></div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <div class="mb-3">
        <label for="reservation_message" class="form-label"><%= t('admin.reservations.message_label') %></label>
        <textarea name="reservation[message]" id="reservation_message" class="form-control" rows="3"></textarea>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit t('admin.reservations.create_reservation'), class: "btn btn-primary" %>
    <%= link_to t('admin.reservations.back'), admin_reservations_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
<% end %>
