<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('admin.reservations.title') %></h1>
  <%= link_to t('admin.reservations.create_new'), new_admin_reservation_path, class: "btn btn-primary" %>
</div>

<ul class="nav nav-tabs mb-4">
  <li class="nav-item">
    <%= link_to t('admin.reservations.all'), admin_reservations_path, class: "nav-link #{params[:status].blank? ? 'active' : ''}" %>
  </li>
  <% Reservation.statuses.keys.each do |status| %>
    <li class="nav-item">
      <%= link_to t("statuses.#{status}"), admin_reservations_path(status: status), class: "nav-link #{params[:status] == status ? 'active' : ''}" %>
    </li>
  <% end %>
</ul>

<% if @reservations.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th><%= t('admin.reservations.date') %></th>
          <th><%= t('admin.reservations.user') %></th>
          <th><%= t('admin.reservations.email') %></th>
          <th><%= t('admin.reservations.phone') %></th>
          <th><%= t('admin.reservations.items_count') %></th>
          <th><%= t('admin.reservations.status') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @reservations.each do |reservation| %>
          <tr>
            <td><%= reservation.created_at.strftime("%b %d, %Y %H:%M") %></td>
            <td>
              <%= reservation.display_name %>
              <% if reservation.guest? %>
                <span class="badge bg-info"><%= t('admin.reservations.guest_badge') %></span>
              <% end %>
            </td>
            <td><%= reservation.display_email %></td>
            <td><%= reservation.display_phone %></td>
            <td><%= reservation.reservation_items.sum(:quantity) %></td>
            <td>
              <% status_colors = { "pending" => "warning", "paid" => "info", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
              <span class="badge bg-<%= status_colors[reservation.status] %>"><%= t("statuses.#{reservation.status}") %></span>
            </td>
            <td>
              <%= link_to admin_reservation_path(reservation), class: "btn btn-sm btn-outline-primary", title: t('admin.reservations.view') do %><i class="fas fa-eye"></i><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @reservations %>
<% else %>
  <div class="alert alert-info"><%= t('admin.reservations.no_reservations') %></div>
<% end %>
<% end %>
