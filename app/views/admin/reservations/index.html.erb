<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4 admin-header-actions">
  <h1><%= t('admin.reservations.title') %></h1>
  <div class="d-flex gap-2">
    <%= link_to t('admin.reservations.create_new'), new_admin_reservation_path, class: "btn btn-primary" %>
    <%= link_to t('admin.reservations.import_from_list'), import_admin_reservations_path, class: "btn btn-outline-primary" %>
  </div>
</div>

<%= form_tag admin_reservations_path, method: :get, class: "mb-3 d-flex align-items-center gap-2" do %>
  <%= hidden_field_tag :status, params[:status] %>
  <%= text_field_tag :card_name, params[:card_name], class: "form-control form-control-sm", placeholder: t('admin.reservations.search_by_card_name'), style: "max-width: 300px;" %>
  <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i> <%= t('admin.reservations.search') %></button>
  <% if params[:card_name].present? %>
    <%= link_to t('admin.reservations.clear_search'), admin_reservations_path(status: params[:status]), class: "btn btn-sm btn-outline-secondary" %>
  <% end %>
<% end %>

<% active_status = params[:status].presence || "pending" %>
<ul class="nav nav-tabs mb-4">
  <% Reservation.statuses.keys.each do |status| %>
    <li class="nav-item">
      <%= link_to t("statuses.#{status}"), admin_reservations_path(status: status, card_name: params[:card_name].presence), class: "nav-link #{active_status == status ? 'active' : ''}" %>
    </li>
  <% end %>
  <li class="nav-item">
    <% pending_receipt_count = Reservation.where(status: :prepared).where.not(receipt_sent_at: nil).count %>
    <%= link_to admin_reservations_path(status: "pending_receipt", card_name: params[:card_name].presence), class: "nav-link #{active_status == 'pending_receipt' ? 'active' : ''}" do %>
      <%= t('admin.reservations.pending_receipt') %>
      <% if pending_receipt_count > 0 %>
        <span class="badge bg-warning text-dark"><%= pending_receipt_count %></span>
      <% end %>
    <% end %>
  </li>
  <li class="nav-item">
    <% price_changed_count = Reservation.with_price_changes.count %>
    <%= link_to admin_reservations_path(status: "price_changed", card_name: params[:card_name].presence), class: "nav-link #{active_status == 'price_changed' ? 'active' : ''}" do %>
      <%= t('admin.reservations.price_changed') %>
      <% if price_changed_count > 0 %>
        <span class="badge bg-danger"><%= price_changed_count %></span>
      <% end %>
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to t('admin.reservations.all'), admin_reservations_path(status: "all", card_name: params[:card_name].presence), class: "nav-link #{active_status == 'all' ? 'active' : ''}" %>
  </li>
</ul>

<% if %w[pending in_preparation prepared paid].include?(active_status) %>
  <div class="d-flex flex-wrap gap-2 mb-3">
    <% base_params = { status: params[:status], card_name: params[:card_name].presence } %>
    <%= link_to t('admin.reservations.shipping_filter.all'), admin_reservations_path(base_params), class: "btn btn-sm #{params[:shipping].blank? ? 'btn-primary' : 'btn-outline-primary'}" %>
    <%= link_to admin_reservations_path(base_params.merge(shipping: "caba")), class: "btn btn-sm #{params[:shipping] == 'caba' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <i class="fas fa-motorcycle me-1"></i><%= t('admin.reservations.shipping_filter.caba') %>
    <% end %>
    <%= link_to admin_reservations_path(base_params.merge(shipping: "correo")), class: "btn btn-sm #{params[:shipping] == 'correo' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <i class="fas fa-box me-1"></i><%= t('admin.reservations.shipping_filter.correo') %>
    <% end %>
    <%= link_to admin_reservations_path(base_params.merge(shipping: "pickup")), class: "btn btn-sm #{params[:shipping] == 'pickup' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <i class="fas fa-handshake me-1"></i><%= t('admin.reservations.shipping_filter.pickup') %>
    <% end %>
    <%= link_to admin_reservations_path(base_params.merge(shipping: "none")), class: "btn btn-sm #{params[:shipping] == 'none' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <i class="fas fa-question-circle me-1"></i><%= t('admin.reservations.shipping_filter.none') %>
    <% end %>
  </div>

  <% if params[:shipping] == "pickup" %>
    <div class="d-flex flex-wrap gap-2 mb-3 ms-3">
      <%= link_to t('admin.reservations.shipping_filter.all'), admin_reservations_path(base_params.merge(shipping: "pickup")), class: "btn btn-sm #{params[:pickup_location].blank? ? 'btn-secondary' : 'btn-outline-secondary'}" %>
      <% Reservation::PICKUP_LOCATIONS.each do |location| %>
        <%= link_to admin_reservations_path(base_params.merge(shipping: "pickup", pickup_location: location)), class: "btn btn-sm #{params[:pickup_location] == location ? 'btn-secondary' : 'btn-outline-secondary'}" do %>
          <i class="fas fa-store me-1"></i><%= t("admin.reservations.delivery_locations.#{location}") %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if @reservations.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover admin-mobile-table">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th><%= t('admin.reservations.date') %></th>
          <th><%= t('admin.reservations.user') %></th>
          <th><%= t('admin.reservations.email') %></th>
          <th><%= t('admin.reservations.phone') %></th>
          <th><%= t('admin.reservations.items_count') %></th>
          <th><%= t('admin.reservations.total') %></th>
          <th><%= t('admin.reservations.status') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @reservations.each do |reservation| %>
          <tr>
            <td data-label="#"><%= reservation.id %></td>
            <td data-label="<%= t('admin.reservations.date') %>"><%= reservation.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></td>
            <td data-label="<%= t('admin.reservations.user') %>">
              <%= reservation.display_name %>
              <% if reservation.guest? %>
                <span class="badge bg-info"><%= t('admin.reservations.guest_badge') %></span>
              <% end %>
            </td>
            <td data-label="<%= t('admin.reservations.email') %>">
              <% if reservation.user.present? %>
                <%= link_to reservation.display_email, admin_user_path(reservation.user) %>
              <% else %>
                <%= reservation.display_email %>
              <% end %>
            </td>
            <td data-label="<%= t('admin.reservations.phone') %>"><%= reservation.display_phone %></td>
            <td data-label="<%= t('admin.reservations.items_count') %>"><%= reservation.reservation_items.sum(:quantity) %></td>
            <td data-label="<%= t('admin.reservations.total') %>"><%= number_to_currency(reservation.total_price) %></td>
            <td data-label="<%= t('admin.reservations.status') %>">
              <% status_colors = { "pending" => "warning", "in_preparation" => "warning-subtle text-warning-emphasis", "prepared" => "primary", "paid" => "info", "shipped" => "dark", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
              <span class="badge bg-<%= status_colors[reservation.status] %>"><%= t("statuses.#{reservation.status}") %></span>
              <% if reservation.trade? %>
                <span class="badge bg-info"><%= t('admin.reservations.trade_badge') %></span>
              <% end %>
              <% if reservation.receipt_sent_at.present? && !reservation.paid? && !reservation.shipped? && !reservation.fulfilled? %>
                <span class="badge bg-warning text-dark" title="<%= t('admin.reservations.receipt_sent_at', time: reservation.receipt_sent_at.in_time_zone.strftime('%d/%m/%Y %H:%M')) %>"><i class="fas fa-receipt"></i></span>
              <% end %>
            </td>
            <td data-label="">
              <%= link_to admin_reservation_path(reservation), class: "btn btn-sm btn-outline-primary", title: t('admin.reservations.view') do %><i class="fas fa-eye"></i> <span class="d-md-none"><%= t('admin.reservations.view') %></span><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @reservations %>
<% else %>
  <div class="alert alert-info"><%= t('admin.reservations.no_reservations') %></div>
<% end %>
<% end %>
