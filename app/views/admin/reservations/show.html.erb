<%= render layout: 'layouts/admin_sidebar' do %>
<div class="d-flex justify-content-between align-items-center mb-4 admin-header-actions">
  <h1><%= t('admin.reservations.show_title', id: @reservation.id) %></h1>
  <%= link_to t('admin.reservations.back'), "javascript:history.back()", class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <h5>
      <%= t('admin.reservations.user_info') %>
      <% if @reservation.guest? %>
        <span class="badge bg-info"><%= t('admin.reservations.guest_badge') %></span>
      <% end %>
    </h5>
    <p><strong><%= t('admin.reservations.name') %></strong> <%= @reservation.display_name %></p>
    <p><strong><%= t('admin.reservations.email_label') %></strong> <%= @reservation.display_email %></p>
    <p><strong><%= t('admin.reservations.phone_label') %></strong> <%= @reservation.display_phone || t('admin.reservations.na') %></p>

    <hr>

    <% status_colors = { "pending" => "warning", "prepared" => "primary", "paid" => "info", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
    <p><strong><%= t('admin.reservations.status_label') %></strong> <span class="badge bg-<%= status_colors[@reservation.status] %>"><%= t("statuses.#{@reservation.status}") %></span></p>
    <p><strong><%= t('admin.reservations.date_label') %></strong> <%= @reservation.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></p>
    <% if @reservation.message.present? %>
      <p><strong><%= t('admin.reservations.message_label') %></strong> <%= @reservation.message %></p>
    <% end %>
    <% if @reservation.payment_method.present? %>
      <p><strong><%= t('admin.reservations.payment_method_label') %></strong> <%= t("admin.reservations.payment_methods.#{@reservation.payment_method}") %></p>
    <% end %>
    <p>
      <strong><%= t('admin.reservations.trade_label') %></strong>
      <% if @reservation.trade? %>
        <span class="badge bg-info"><%= t('admin.reservations.trade_yes') %></span>
      <% else %>
        <span class="badge bg-secondary"><%= t('admin.reservations.trade_no') %></span>
      <% end %>
      <%= button_to toggle_trade_admin_reservation_path(@reservation), method: :patch, class: "btn btn-sm btn-outline-secondary ms-2" do %>
        <%= @reservation.trade? ? t('admin.reservations.unmark_trade') : t('admin.reservations.mark_trade') %>
      <% end %>
    </p>
    <% if @reservation.receipt_sent_at.present? %>
      <p>
        <strong><%= t('admin.reservations.receipt_label') %></strong>
        <span class="badge bg-warning text-dark"><i class="fas fa-receipt me-1"></i><%= t('admin.reservations.receipt_sent_at', time: @reservation.receipt_sent_at.in_time_zone.strftime('%d/%m/%Y %H:%M')) %></span>
      </p>
    <% end %>
  </div>
</div>

<div id="items" class="d-flex justify-content-between align-items-center mb-2">
  <h4 class="mb-0"><%= t('admin.reservations.items_title') %></h4>
  <div class="btn-group btn-group-sm">
    <%= link_to admin_reservation_path(@reservation, view: "list"), class: "btn #{params[:view] != 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
      </svg>
      <%= t('cards.list') %>
    <% end %>
    <%= link_to admin_reservation_path(@reservation, view: "grid"), class: "btn #{params[:view] == 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
      </svg>
      <%= t('cards.grid') %>
    <% end %>
  </div>
</div>

<% if params[:view] == "grid" %>
  <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3 mb-3">
    <% @reservation.reservation_items.each do |item| %>
      <% stock_short = (@reservation.pending? || @reservation.prepared? || @reservation.paid?) && item.card.quantity < item.quantity %>
      <div class="col">
        <div class="card h-100<%= ' foil-card' if item.card.foil.present? %><%= ' border-danger' if stock_short %>">
          <img src="https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=normal"
               class="card-img-top"
               alt="<%= item.card.name %>"
               loading="lazy"
               onerror="this.onerror=null;this.src='https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=large';this.onerror=function(){this.style.display=\'none\'};">
          <div class="card-body p-2">
            <h6 class="card-title mb-1"><%= item.card.name %></h6>
            <small class="text-muted">
              <%= item.card.edition_name || item.card.edition.upcase %> #<%= item.card.collector_number %><br>
              <%= item.card.condition %> · <%= item.card.language %>
              <% if item.card.foil.present? %>
                · <i class="fa-solid fa-star" style="color: #d4a017;"></i> <span class="badge" style="background-color: #d4a017;"><%= item.card.foil_display %></span>
              <% end %>
            </small>
            <div class="mt-1">
              <small class="text-muted"><%= t('admin.reservations.current_price') %>: <%= item.card.price ? number_to_currency(item.card.price) : "—" %>
                <% if item.card.price_source == "scryfall" && !item.card.price_reviewed? %>
                  <span class="badge bg-warning text-dark" title="<%= t('admin.cards.price_from_scryfall') %>"><i class="fas fa-exclamation-triangle"></i></span>
                <% end %>
              </small><br>
              <strong class="text-price"><%= t('admin.reservations.price') %>: <%= item.unit_price ? number_to_currency(item.unit_price) : "—" %></strong><br>
              <small><%= t('admin.reservations.quantity') %>: <%= item.quantity %></small>
            </div>
            <% if stock_short %>
              <span class="badge bg-danger mt-1" title="<%= t('admin.reservations.stock_warning_detail', in_stock: item.card.quantity, reserved: item.quantity) %>">
                <i class="fas fa-exclamation-triangle me-1"></i><%= t('admin.reservations.low_stock') %>
              </span>
            <% end %>
            <% if @reservation.pending? || @reservation.prepared? %>
              <div class="mt-2">
                <%= button_to remove_item_admin_reservation_path(@reservation, item_id: item.id), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: t('admin.reservations.remove_item_confirm', name: item.card.name) } } do %><i class="fas fa-trash me-1"></i><%= t('admin.reservations.remove_item') %><% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
<div class="table-responsive">
  <table class="table table-striped admin-mobile-table">
    <thead class="table-dark">
      <tr>
        <th><%= t('admin.reservations.card_name') %></th>
        <th><%= t('admin.reservations.edition') %></th>
        <th><%= t('admin.reservations.condition') %></th>
        <th><%= t('admin.reservations.language') %></th>
        <th><%= t('admin.reservations.quantity') %></th>
        <th><%= t('admin.reservations.current_price') %></th>
        <th><%= t('admin.reservations.price') %></th>
        <th><%= t('admin.reservations.subtotal') %></th>
        <% if @reservation.pending? || @reservation.prepared? %><th></th><% end %>
      </tr>
    </thead>
    <tbody>
      <% @reservation.reservation_items.each do |item| %>
        <% stock_short = (@reservation.pending? || @reservation.prepared? || @reservation.paid?) && item.card.quantity < item.quantity %>
        <tr class="<%= 'table-danger' if stock_short %>">
          <td data-label="<%= t('admin.reservations.card_name') %>">
            <%= item.card.name %>
            <% if stock_short %>
              <span class="badge bg-danger" title="<%= t('admin.reservations.stock_warning_detail', in_stock: item.card.quantity, reserved: item.quantity) %>">
                <i class="fas fa-exclamation-triangle me-1"></i><%= t('admin.reservations.low_stock') %>
              </span>
            <% end %>
          </td>
          <td data-label="<%= t('admin.reservations.edition') %>"><%= item.card.edition_name || item.card.edition.upcase %></td>
          <td data-label="<%= t('admin.reservations.condition') %>"><%= item.card.condition %></td>
          <td data-label="<%= t('admin.reservations.language') %>"><%= item.card.language %></td>
          <td data-label="<%= t('admin.reservations.quantity') %>"><%= item.quantity %></td>
          <td data-label="<%= t('admin.reservations.current_price') %>">
            <%= item.card.price ? number_to_currency(item.card.price) : "—" %>
            <% if item.card.price_source == "scryfall" && !item.card.price_reviewed? %>
              <span class="badge bg-warning text-dark" title="<%= t('admin.cards.price_from_scryfall') %>"><i class="fas fa-exclamation-triangle"></i></span>
            <% end %>
          </td>
          <td data-label="<%= t('admin.reservations.price') %>">
            <%= item.unit_price ? number_to_currency(item.unit_price) : "—" %>
            <% if @reservation.pending? || @reservation.prepared? || @reservation.paid? %>
              <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-bs-toggle="modal" data-bs-target="#editPriceModal<%= item.id %>" title="<%= t('admin.reservations.edit_price') %>">
                <i class="fas fa-pencil-alt"></i>
              </button>
            <% end %>
          </td>
          <td data-label="<%= t('admin.reservations.subtotal') %>"><%= item.unit_price ? number_to_currency(item.unit_price * item.quantity) : "—" %></td>
          <% if @reservation.pending? || @reservation.prepared? %>
            <td data-label="">
              <%= button_to remove_item_admin_reservation_path(@reservation, item_id: item.id), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: t('admin.reservations.remove_item_confirm', name: item.card.name) } } do %><i class="fas fa-trash"></i><% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="<%= (@reservation.pending? || @reservation.prepared?) ? 8 : 7 %>" class="text-end"><strong><%= t('admin.reservations.original_total') %></strong></td>
        <td><strong><%= number_to_currency(@reservation.reservation_items.sum { |i| (i.unit_price || 0) * i.quantity }) %></strong></td>
      </tr>
      <tr>
        <td colspan="<%= (@reservation.pending? || @reservation.prepared?) ? 8 : 7 %>" class="text-end"><strong><%= t('admin.reservations.final_price') %></strong></td>
        <td>
          <%= form_tag update_final_price_admin_reservation_path(@reservation), method: :patch, class: "d-flex align-items-center gap-1" do %>
            <input type="number" name="final_price" step="0.01" min="0" value="<%= @reservation.final_price %>" class="form-control form-control-sm" style="width: 120px;" placeholder="—">
            <%= submit_tag t('admin.reservations.set_final_price'), class: "btn btn-sm btn-outline-primary" %>
          <% end %>
        </td>
      </tr>
    </tfoot>
  </table>
</div>
<% end %>

<% @reservation.reservation_items.each do |item| %>
  <div class="modal fade" id="editPriceModal<%= item.id %>" tabindex="-1" aria-labelledby="editPriceModalLabel<%= item.id %>" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_tag update_item_price_admin_reservation_path(@reservation), method: :patch do %>
          <input type="hidden" name="item_id" value="<%= item.id %>">
          <div class="modal-header">
            <h5 class="modal-title" id="editPriceModalLabel<%= item.id %>"><%= t('admin.reservations.edit_price_title') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p><strong><%= item.card.name %></strong></p>
            <p><%= t('admin.reservations.price') %>: <%= item.unit_price ? number_to_currency(item.unit_price) : "—" %></p>
            <label for="new_price_<%= item.id %>" class="form-label"><%= t('admin.reservations.new_price') %></label>
            <input type="number" name="unit_price" id="new_price_<%= item.id %>" step="0.01" min="0" value="<%= item.unit_price %>" class="form-control" required>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('admin.reservations.cancel_modal') %></button>
            <%= submit_tag t('admin.reservations.save_price'), class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% if @reservation.pending? || @reservation.prepared? %>
  <div class="card mb-4 mt-4" data-controller="add-item-search" data-search-url="<%= search_cards_for_add_admin_reservation_path(@reservation) %>">
    <div class="card-body">
      <h5><%= t('admin.reservations.add_cards') %></h5>
      <div class="input-group mb-3">
        <input type="text" class="form-control"
               placeholder="<%= t('admin.reservations.search_cards_placeholder') %>"
               data-add-item-search-target="searchInput"
               data-action="keydown.enter->add-item-search#search">
        <button type="button" class="btn btn-outline-primary"
                data-action="click->add-item-search#search">
          <%= t('admin.reservations.search') %>
        </button>
      </div>
      <div data-add-item-search-target="searchResults"></div>
    </div>
  </div>
<% end %>

<% if @reservation.prepared? || @reservation.reservation_payments.any? %>
<h4 class="mt-4"><%= t('admin.reservations.payments_title') %></h4>
<div class="card mb-3">
  <div class="card-body">
    <% if @reservation.reservation_payments.any? %>
      <table class="table table-sm mb-3">
        <thead>
          <tr>
            <th><%= t('admin.reservations.payment_date') %></th>
            <th><%= t('admin.reservations.payment_amount') %></th>
            <th><%= t('admin.reservations.payment_note') %></th>
            <% if @reservation.prepared? %><th></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% @reservation.reservation_payments.order(created_at: :asc).each do |payment| %>
            <tr>
              <td><%= payment.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></td>
              <td><%= number_to_currency(payment.amount) %></td>
              <td><%= payment.note %></td>
              <% if @reservation.prepared? %>
                <td>
                  <%= button_to admin_reservation_payment_path(@reservation, payment), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: t('admin.reservations.delete_payment_confirm') } } do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <div class="d-flex gap-4 mb-3">
      <div>
        <strong><%= t('admin.reservations.total_label') %></strong> <%= number_to_currency(@reservation.total_price) %>
      </div>
      <div>
        <strong><%= t('admin.reservations.total_paid_label') %></strong> <%= number_to_currency(@reservation.total_paid) %>
      </div>
      <div>
        <strong><%= t('admin.reservations.remaining_label') %></strong>
        <span class="<%= @reservation.remaining_balance > 0 ? 'text-danger' : 'text-success' %>">
          <%= number_to_currency(@reservation.remaining_balance) %>
        </span>
      </div>
    </div>

    <% if @reservation.prepared? %>
      <%= form_tag admin_reservation_payments_path(@reservation), method: :post, class: "d-flex align-items-end gap-2 flex-wrap" do %>
        <div>
          <label class="form-label mb-1"><%= t('admin.reservations.payment_amount') %></label>
          <input type="number" name="amount" step="0.01" min="0.01" class="form-control form-control-sm" style="width: 120px;" required>
        </div>
        <div>
          <label class="form-label mb-1"><%= t('admin.reservations.payment_note') %></label>
          <input type="text" name="note" class="form-control form-control-sm" style="width: 200px;" placeholder="<%= t('admin.reservations.payment_note_placeholder') %>">
        </div>
        <%= submit_tag t('admin.reservations.add_payment'), class: "btn btn-sm btn-outline-success" %>
      <% end %>
    <% end %>
  </div>
</div>
<% end %>

<h4 class="mt-4"><%= t('admin.reservations.public_notes') %></h4>
<div class="card mb-3">
  <div class="card-body">
    <% public_notes = @reservation.reservation_notes.public_notes.order(created_at: :asc) %>
    <% if public_notes.any? %>
      <% public_notes.each do |note| %>
        <div class="mb-2">
          <strong><%= note.user&.admin? ? t('admin.reservations.admin_label') : note.user&.name %></strong>
          <small class="text-muted ms-2"><%= note.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></small>
          <p class="mb-0"><%= simple_format(note.body) %></p>
        </div>
        <hr class="my-1">
      <% end %>
    <% else %>
      <p class="text-muted mb-2"><%= t('admin.reservations.no_public_notes') %></p>
    <% end %>

    <%= form_tag admin_reservation_notes_path(@reservation), method: :post, class: "mt-2" do %>
      <input type="hidden" name="public" value="true">
      <div class="mb-2">
        <textarea name="body" class="form-control" rows="2" placeholder="<%= t('admin.reservations.public_note_placeholder') %>" required></textarea>
      </div>
      <%= submit_tag t('admin.reservations.add_public_note'), class: "btn btn-sm btn-outline-primary" %>
    <% end %>
  </div>
</div>

<h4 class="mt-4"><%= t('admin.reservations.internal_notes') %></h4>
<div class="card mb-3">
  <div class="card-body">
    <% internal_notes = @reservation.reservation_notes.internal.order(created_at: :desc) %>
    <% if internal_notes.any? %>
      <% internal_notes.each do |note| %>
        <div class="mb-2">
          <small class="text-muted"><%= note.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></small>
          <p class="mb-0"><%= simple_format(note.body) %></p>
        </div>
        <hr class="my-1">
      <% end %>
    <% end %>

    <%= form_tag admin_reservation_notes_path(@reservation), method: :post, class: "mt-2" do %>
      <div class="mb-2">
        <textarea name="body" class="form-control" rows="2" placeholder="<%= t('admin.reservations.note_placeholder') %>" required></textarea>
      </div>
      <%= submit_tag t('admin.reservations.add_note'), class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
  </div>
</div>

<% if @reservation.pending? %>
  <div class="mt-3 d-flex gap-2">
    <%= button_to t('admin.reservations.prepare'), prepare_admin_reservation_path(@reservation), method: :patch, class: "btn btn-primary" %>
    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#expireModal">
      <%= t('admin.reservations.expire') %>
    </button>
  </div>

  <div class="modal fade" id="expireModal" tabindex="-1" aria-labelledby="expireModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_tag expire_admin_reservation_path(@reservation), method: :patch do %>
          <div class="modal-header">
            <h5 class="modal-title" id="expireModalLabel"><%= t('admin.reservations.expire') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <label for="expire_message" class="form-label"><%= t('admin.reservations.expire_message_label') %></label>
            <textarea name="message" id="expire_message" class="form-control" rows="5" placeholder="<%= t('admin.reservations.expire_message_placeholder') %>"></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('admin.reservations.cancel_modal') %></button>
            <%= submit_tag t('admin.reservations.confirm_expire'), class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% elsif @reservation.prepared? %>
  <div class="mt-3 d-flex gap-2">
    <%= button_to t('admin.reservations.pay'), pay_admin_reservation_path(@reservation), method: :patch, class: "btn btn-info" %>
    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#expireModal">
      <%= t('admin.reservations.expire') %>
    </button>
  </div>

  <div class="modal fade" id="expireModal" tabindex="-1" aria-labelledby="expireModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_tag expire_admin_reservation_path(@reservation), method: :patch do %>
          <div class="modal-header">
            <h5 class="modal-title" id="expireModalLabel"><%= t('admin.reservations.expire') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <label for="expire_message" class="form-label"><%= t('admin.reservations.expire_message_label') %></label>
            <textarea name="message" id="expire_message" class="form-control" rows="5" placeholder="<%= t('admin.reservations.expire_message_placeholder') %>"></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('admin.reservations.cancel_modal') %></button>
            <%= submit_tag t('admin.reservations.confirm_expire'), class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% elsif @reservation.paid? %>
  <div class="mt-3 d-flex gap-2">
    <%= button_to t('admin.reservations.fulfill'), fulfill_admin_reservation_path(@reservation), method: :patch, class: "btn btn-success" %>
  </div>
<% elsif @reservation.fulfilled? %>
  <div class="mt-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#revertToPaidModal">
      <%= t('admin.reservations.revert_to_paid') %>
    </button>
    <%= button_to t('admin.reservations.force_decrement'), force_decrement_admin_reservation_path(@reservation), method: :patch, class: "btn btn-outline-danger", form: { data: { turbo_confirm: t('admin.reservations.force_decrement_confirm') } } %>
  </div>

  <div class="modal fade" id="revertToPaidModal" tabindex="-1" aria-labelledby="revertToPaidModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <%= form_tag revert_to_paid_admin_reservation_path(@reservation), method: :patch do %>
          <div class="modal-header">
            <h5 class="modal-title" id="revertToPaidModalLabel"><%= t('admin.reservations.revert_to_paid') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p><%= t('admin.reservations.revert_to_paid_confirm') %></p>
            <div class="form-check">
              <%= check_box_tag :restore_quantities, "1", false, class: "form-check-input", id: "restore_quantities" %>
              <label class="form-check-label" for="restore_quantities">
                <%= t('admin.reservations.restore_quantities_label') %>
              </label>
              <div class="form-text"><%= t('admin.reservations.restore_quantities_hint') %></div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('admin.reservations.cancel_modal') %></button>
            <%= submit_tag t('admin.reservations.confirm_revert'), class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<% end %>
