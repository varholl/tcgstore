<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('admin.reservations.show_title', id: @reservation.id) %></h1>
  <%= link_to t('admin.reservations.back'), admin_reservations_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <h5><%= t('admin.reservations.user_info') %></h5>
    <p><strong><%= t('admin.reservations.name') %></strong> <%= @reservation.user.name %></p>
    <p><strong><%= t('admin.reservations.email_label') %></strong> <%= @reservation.user.email %></p>
    <p><strong><%= t('admin.reservations.phone_label') %></strong> <%= @reservation.user.phone_number || t('admin.reservations.na') %></p>

    <hr>

    <% status_colors = { "pending" => "warning", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
    <p><strong><%= t('admin.reservations.status_label') %></strong> <span class="badge bg-<%= status_colors[@reservation.status] %>"><%= t("statuses.#{@reservation.status}") %></span></p>
    <p><strong><%= t('admin.reservations.date_label') %></strong> <%= @reservation.created_at.strftime("%b %d, %Y %H:%M") %></p>
    <% if @reservation.message.present? %>
      <p><strong><%= t('admin.reservations.message_label') %></strong> <%= @reservation.message %></p>
    <% end %>
  </div>
</div>

<h4><%= t('admin.reservations.items_title') %></h4>
<div class="table-responsive">
  <table class="table table-striped">
    <thead class="table-dark">
      <tr>
        <th><%= t('admin.reservations.card_name') %></th>
        <th><%= t('admin.reservations.edition') %></th>
        <th><%= t('admin.reservations.condition') %></th>
        <th><%= t('admin.reservations.quantity') %></th>
      </tr>
    </thead>
    <tbody>
      <% @reservation.reservation_items.each do |item| %>
        <tr>
          <td><%= item.card.name %></td>
          <td><%= item.card.edition_name || item.card.edition.upcase %></td>
          <td><%= item.card.condition %></td>
          <td><%= item.quantity %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @reservation.pending? %>
  <div class="mt-3 d-flex gap-2">
    <%= button_to t('admin.reservations.fulfill'), fulfill_admin_reservation_path(@reservation), method: :patch, class: "btn btn-success" %>
    <%= button_to t('admin.reservations.expire'), expire_admin_reservation_path(@reservation), method: :patch, class: "btn btn-warning" %>
  </div>
<% end %>
