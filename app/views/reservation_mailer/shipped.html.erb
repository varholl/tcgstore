<p><%= t('reservation_mailer.shipped.greeting', name: @reservation.display_name) %></p>

<p><%= t('reservation_mailer.shipped.body', id: @reservation.id) %></p>

<table class="items-table">
  <thead>
    <tr>
      <th><%= t('reservation_mailer.common.card_name') %></th>
      <th><%= t('reservation_mailer.common.edition') %></th>
      <th><%= t('reservation_mailer.common.quantity') %></th>
      <th><%= t('reservation_mailer.common.price') %></th>
      <th><%= t('reservation_mailer.common.subtotal') %></th>
    </tr>
  </thead>
  <tbody>
    <% @items.each do |item| %>
      <tr>
        <td><%= item.card.name %></td>
        <td><%= item.card.edition_name %></td>
        <td><%= item.quantity %></td>
        <td><%= number_to_currency(item.unit_price) %></td>
        <td><%= number_to_currency(item.unit_price * item.quantity) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p class="total-row"><%= t('reservation_mailer.common.total', amount: number_to_currency(@items.sum { |i| i.unit_price * i.quantity })) %></p>

<% if @reservation.tracking_number.present? %>
<p>
  <strong><%= t('reservation_mailer.shipped.tracking_label') %></strong> <%= @reservation.tracking_number %>
  <% if @reservation.tracking_url.present? %>
    <br><a href="<%= @reservation.tracking_url %>"><%= t('reservation_mailer.shipped.track_shipment') %></a>
  <% end %>
</p>
<% end %>

<p><%= t('reservation_mailer.shipped.closing') %></p>
