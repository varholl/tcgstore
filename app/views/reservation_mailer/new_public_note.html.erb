<p><%= t('reservation_mailer.new_public_note.greeting') %></p>

<p><%= t('reservation_mailer.new_public_note.body', id: @reservation.id, author: @author.name) %></p>

<blockquote style="border-left: 3px solid #ccc; padding-left: 10px; color: #555;">
  <%= simple_format(@reservation.reservation_notes.public_notes.order(created_at: :desc).first&.body) %>
</blockquote>

<p><%= t('reservation_mailer.new_public_note.closing') %></p>
