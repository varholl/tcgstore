<h1 class="mb-3"><%= t('pages.how_it_works.title') %></h1>
<p class="lead mb-4"><%= t('pages.how_it_works.intro') %></p>

<div class="row g-4 mb-5">
  <% (1..5).each do |i| %>
    <div class="col-md">
      <div class="card h-100 text-center">
        <div class="card-body">
          <div class="display-4 text-primary mb-2"><%= i %></div>
          <h5 class="card-title"><%= t("pages.how_it_works.steps.step_#{i}.title") %></h5>
          <p class="card-text"><%= t("pages.how_it_works.steps.step_#{i}.description") %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<h2 class="mb-3"><%= t('pages.how_it_works.faq_title') %></h2>
<div class="accordion" id="faqAccordion">
  <% %w[what_is_reservation can_i_cancel do_reservations_expire are_prices_final need_account].each_with_index do |faq, index| %>
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-<%= index %>">
          <%= t("pages.how_it_works.faq.#{faq}.question") %>
        </button>
      </h2>
      <div id="faq-<%= index %>" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
        <div class="accordion-body">
          <%= t("pages.how_it_works.faq.#{faq}.answer") %>
        </div>
      </div>
    </div>
  <% end %>
</div>
