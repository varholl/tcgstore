<h1 class="mb-4"><%= t('cart_items.title') %></h1>

<% if defined?(@unavailable_items) && @unavailable_items.any? %>
  <div class="alert alert-danger">
    <h5><%= t('cart_items.unavailable_heading') %></h5>
    <ul class="mb-0">
      <% @unavailable_items.each do |item| %>
        <li><strong><%= item[:card].name %></strong> (<%= item[:card].edition_name || item[:card].edition.upcase %>): <%= t('cart_items.unavailable_item', requested: item[:requested], available: item[:available]) %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @cart_items.any? %>
  <% preorder_items = @cart_items.select { |item| item.card.preorder? } %>
  <% if preorder_items.any? %>
    <% latest_release = preorder_items.map { |item| item.card.release_date }.max %>
    <div class="alert alert-info">
      <i class="fas fa-clock me-1"></i>
      <strong><%= t('cart_items.preorder_notice') %></strong>
      <%= t('cart_items.preorder_notice_detail', date: latest_release.strftime("%d/%m/%Y")) %>
    </div>
  <% end %>
  <%# Desktop table — hidden on small screens %>
  <div class="d-none d-md-block table-responsive">
    <table class="table table-striped">
      <thead class="table-dark">
        <tr>
          <th><%= t('cart_items.card_name') %></th>
          <th><%= t('cart_items.edition') %></th>
          <th><%= t('cart_items.condition') %></th>
          <th><%= t('cart_items.price') %></th>
          <th><%= t('cart_items.quantity') %></th>
          <th><%= t('cart_items.subtotal') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @cart_items.each do |item| %>
          <% available = @available_quantities[item.card_id] || 0 %>
          <% unavailable = available <= 0 %>
          <tr class="<%= 'table-danger' if unavailable %>" style="vertical-align: middle;">
            <td class="d-flex align-items-center gap-2">
              <img src="https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=small"
                   alt="<%= item.card.name %>"
                   style="width: 40px; height: auto; border-radius: 3px;<%= ' opacity: 0.5;' if unavailable %>"
                   loading="lazy"
                   onerror="this.style.display='none'">
              <%= item.card.name %>
              <% if item.card.preorder? %>
                <span class="preorder-badge-inline"><%= t('cards.preorder_badge') %></span>
              <% end %>
              <% if unavailable %>
                <span class="badge bg-danger"><%= t('cart_items.not_available') %></span>
              <% end %>
            </td>
            <td><%= item.card.edition_name || item.card.edition.upcase %></td>
            <td><%= item.card.condition %></td>
            <td><%= item.card.price ? number_to_currency(item.card.price) : "—" %></td>
            <td>
              <% if unavailable %>
                <span class="text-danger fw-bold">0</span>
              <% else %>
                <% max_qty = [available, item.quantity].max %>
                <%= form_with model: item, url: cart_item_path(item), method: :patch, class: "d-flex align-items-center gap-2" do |f| %>
                  <%= f.number_field :quantity, value: item.quantity, min: 1, max: max_qty, disabled: available <= 1, class: "form-control form-control-sm", style: "width: 70px" %>
                  <%= f.submit t('cart_items.update'), class: "btn btn-sm btn-outline-primary", disabled: available <= 1 %>
                <% end %>
              <% end %>
            </td>
            <td><%= item.card.price ? number_to_currency(item.card.price * item.quantity) : "—" %></td>
            <td>
              <%= button_to cart_item_path(item), method: :delete, class: "btn btn-sm btn-danger", title: t('cart_items.remove') do %><i class="fa-solid fa-trash"></i><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Mobile card layout — visible only on small screens %>
  <div class="d-md-none">
    <% @cart_items.each do |item| %>
      <% available = @available_quantities[item.card_id] || 0 %>
      <% unavailable = available <= 0 %>
      <div class="card mb-3<%= ' border-danger' if unavailable %>">
        <div class="card-body">
          <div class="d-flex align-items-start gap-3">
            <img src="https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=small"
                 alt="<%= item.card.name %>"
                 style="width: 60px; height: auto; border-radius: 4px;<%= ' opacity: 0.5;' if unavailable %>"
                 loading="lazy"
                 onerror="this.style.display='none'">
            <div class="flex-grow-1">
              <h6 class="mb-1">
                <%= item.card.name %>
                <% if item.card.preorder? %>
                  <span class="preorder-badge-inline"><%= t('cards.preorder_badge') %></span>
                <% end %>
                <% if unavailable %>
                  <span class="badge bg-danger"><%= t('cart_items.not_available') %></span>
                <% end %>
              </h6>
              <p class="text-muted small mb-1">
                <%= item.card.edition_name || item.card.edition.upcase %> · <%= item.card.condition %>
              </p>
              <p class="mb-2">
                <strong><%= item.card.price ? number_to_currency(item.card.price) : "—" %></strong>
              </p>
              <div class="d-flex align-items-center gap-2">
                <% if unavailable %>
                  <span class="text-danger fw-bold"><%= t('cart_items.quantity') %>: 0</span>
                <% else %>
                  <% max_qty = [available, item.quantity].max %>
                  <%= form_with model: item, url: cart_item_path(item), method: :patch, class: "d-flex align-items-center gap-2" do |f| %>
                    <%= f.number_field :quantity, value: item.quantity, min: 1, max: max_qty, disabled: available <= 1, class: "form-control form-control-sm", style: "width: 65px" %>
                    <%= f.submit t('cart_items.update'), class: "btn btn-sm btn-outline-primary", disabled: available <= 1 %>
                  <% end %>
                <% end %>
                <%= button_to cart_item_path(item), method: :delete, class: "btn btn-sm btn-danger", title: t('cart_items.remove') do %><i class="fa-solid fa-trash"></i><% end %>
              </div>
            </div>
          </div>
          <% if item.card.price %>
            <div class="text-end mt-2">
              <span class="text-muted small"><%= t('cart_items.subtotal') %>:</span>
              <strong><%= number_to_currency(item.card.price * item.quantity) %></strong>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="text-end mb-3">
    <%= button_to t('cart_items.empty_cart_button'), destroy_all_cart_items_path, method: :delete, class: "btn btn-outline-danger btn-sm", data: { turbo_confirm: t('cart_items.empty_cart_confirm') } %>
  </div>

  <% total_price = @cart_items.sum { |item| (item.card.price || 0) * item.quantity } %>
  <div class="d-flex justify-content-between align-items-center">
    <p class="text-muted mb-0"><%= t('cart_items.total_items', count: @cart_items.sum(:quantity)) %></p>
    <p class="mb-0"><strong><%= t('cart_items.estimated_total', total: number_to_currency(total_price)) %></strong></p>
  </div>

  <hr>

  <% if maintenance_mode? %>
    <div class="alert alert-warning">
      <i class="fas fa-tools me-1"></i>
      <%= @maintenance_message.presence || t('maintenance.default_message') %>
    </div>
  <% else %>
    <%= form_tag reservations_path, method: :post, class: "mt-3", data: { controller: "shipping-method" } do %>
      <div class="mb-4">
        <label class="form-label fw-bold"><i class="fas fa-truck me-1"></i><%= t('cart_items.shipping.title') %></label>

        <div class="row g-2">
          <div class="col-6 col-md-3">
            <input type="radio" name="shipping_method" value="store_pickup" id="ship_store" class="btn-check"
                   data-action="shipping-method#toggle" <%= 'checked' if params[:shipping_method] == 'store_pickup' %>>
            <label class="btn btn-outline-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3" for="ship_store">
              <i class="fas fa-handshake fa-lg mb-2"></i>
              <small><%= t('cart_items.shipping.store_pickup') %></small>
            </label>
          </div>
          <div class="col-6 col-md-3">
            <input type="radio" name="shipping_method" value="bike_delivery" id="ship_bike" class="btn-check"
                   data-action="shipping-method#toggle" <%= 'checked' if params[:shipping_method] == 'bike_delivery' %>>
            <label class="btn btn-outline-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3" for="ship_bike">
              <i class="fas fa-motorcycle fa-lg mb-2"></i>
              <small><%= t('cart_items.shipping.bike_delivery') %></small>
            </label>
          </div>
          <div class="col-6 col-md-3">
            <input type="radio" name="shipping_method" value="andreani" id="ship_andreani" class="btn-check"
                   data-action="shipping-method#toggle" <%= 'checked' if params[:shipping_method] == 'andreani' %>>
            <label class="btn btn-outline-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3" for="ship_andreani">
              <i class="fas fa-box fa-lg mb-2"></i>
              <small><%= t('cart_items.shipping.andreani') %></small>
            </label>
          </div>
          <div class="col-6 col-md-3">
            <input type="radio" name="shipping_method" value="correo_argentino" id="ship_correo" class="btn-check"
                   data-action="shipping-method#toggle" <%= 'checked' if params[:shipping_method] == 'correo_argentino' %>>
            <label class="btn btn-outline-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3" for="ship_correo">
              <i class="fas fa-envelope fa-lg mb-2"></i>
              <small><%= t('cart_items.shipping.correo_argentino') %></small>
            </label>
          </div>
        </div>

        <%# Store pickup options %>
        <div class="mt-3" data-shipping-method-target="storePickupOptions" style="<%= 'display: none;' unless params[:shipping_method] == 'store_pickup' %>">
          <label class="form-label"><%= t('cart_items.shipping.pickup_location') %></label>
          <p class="text-muted small mb-2"><%= t('cart_items.shipping.pickup_hint_html') %></p>
          <% location_maps = { "batikueva" => "https://maps.app.goo.gl/tKwH5AAR88zrksRa9", "magic_palace" => "https://maps.app.goo.gl/5zBt5T6Sii3GEaCC9" } %>
          <% location_websites = { "batikueva" => "https://www.labatikuevastore.com/", "magic_palace" => "https://magicpalacetcg.com.ar/" } %>
          <div class="d-flex flex-wrap gap-4">
            <% Reservation::PICKUP_LOCATIONS.each do |loc| %>
              <div>
                <input type="radio" name="pickup_location" value="<%= loc %>" id="pickup_<%= loc %>" class="btn-check"
                       <%= 'checked' if params[:pickup_location] == loc || (params[:pickup_location].blank? && loc == Reservation::PICKUP_LOCATIONS.first) %>>
                <label class="btn btn-outline-secondary" for="pickup_<%= loc %>">
                  <i class="fas fa-map-marker-alt me-1"></i><%= t("cart_items.shipping.locations.#{loc}") %>
                </label>
                <div class="mt-1 d-flex gap-2">
                  <% if location_websites[loc] %>
                    <a href="<%= location_websites[loc] %>" target="_blank" rel="noopener noreferrer" class="small text-decoration-none">
                      <i class="fas fa-globe me-1"></i><%= t('cart_items.shipping.view_website') %>
                    </a>
                  <% end %>
                  <% if location_maps[loc] %>
                    <a href="<%= location_maps[loc] %>" target="_blank" rel="noopener noreferrer" class="small text-decoration-none">
                      <i class="fas fa-map-marker-alt me-1"></i><%= t('cart_items.shipping.view_map') %>
                    </a>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# Bike delivery options (placeholder for future) %>
        <div class="mt-3" data-shipping-method-target="bikeDeliveryOptions" style="display: none;">
          <div class="alert alert-info mb-0">
            <i class="fas fa-info-circle me-1"></i> <%= t('cart_items.shipping.bike_caba_note') %>
          </div>
        </div>

        <%# Andreani options (placeholder for future) %>
        <div class="mt-3" data-shipping-method-target="andreaniOptions" style="display: none;">
          <div class="alert alert-info mb-0">
            <i class="fas fa-info-circle me-1"></i> <%= t('cart_items.shipping.andreani_note') %>
          </div>
        </div>

        <%# Correo Argentino options (placeholder for future) %>
        <div class="mt-3" data-shipping-method-target="correoOptions" style="display: none;">
          <div class="alert alert-info mb-0">
            <i class="fas fa-info-circle me-1"></i> <%= t('cart_items.shipping.correo_note') %>
          </div>
        </div>
      </div>

      <div class="mb-3">
        <%= label_tag :message, t('cart_items.message_label'), class: "form-label" %>
        <%= text_area_tag :message, params[:message], class: "form-control", rows: 3, maxlength: 1000, placeholder: t('cart_items.message_placeholder') %>
      </div>
      <p class="text-muted small"><%= t('cart_items.disclaimer') %></p>
      <%= submit_tag t('cart_items.submit_reservation'), class: "btn btn-primary btn-lg", disabled: params[:shipping_method].blank?, data: { shipping_method_target: "submitButton" } %>
    <% end %>
  <% end %>
<% else %>
  <div class="alert alert-info">
    <%= t('cart_items.empty_cart') %> <%= link_to t('cart_items.browse_cards'), cards_path %> <%= t('cart_items.empty_cart_message') %>
  </div>
<% end %>
