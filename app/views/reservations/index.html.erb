<h1 class="mb-4"><%= t('reservations.title') %></h1>

<% if @reservations.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th><%= t('reservations.date') %></th>
          <th><%= t('reservations.items_count') %></th>
          <th><%= t('reservations.status') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @reservations.each do |reservation| %>
          <tr>
            <td><%= reservation.created_at.strftime("%b %d, %Y %H:%M") %></td>
            <td><%= reservation.reservation_items.sum(:quantity) %></td>
            <td>
              <% status_colors = { "pending" => "warning", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
              <span class="badge bg-<%= status_colors[reservation.status] %>"><%= t("statuses.#{reservation.status}") %></span>
            </td>
            <td>
              <%= link_to t('reservations.view'), reservation_path(reservation), class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @reservations %>
<% else %>
  <div class="alert alert-info">
    <%= t('reservations.no_reservations') %> <%= link_to t('reservations.browse_cards'), cards_path %> <%= t('reservations.no_reservations_message') %>
  </div>
<% end %>
