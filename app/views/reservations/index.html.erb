<h1 class="mb-4">My Reservations</h1>

<% if @reservations.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>Date</th>
          <th># Items</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @reservations.each do |reservation| %>
          <tr>
            <td><%= reservation.created_at.strftime("%b %d, %Y %H:%M") %></td>
            <td><%= reservation.reservation_items.sum(:quantity) %></td>
            <td>
              <% status_colors = { "pending" => "warning", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
              <span class="badge bg-<%= status_colors[reservation.status] %>"><%= reservation.status.capitalize %></span>
            </td>
            <td>
              <%= link_to "View", reservation_path(reservation), class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @reservations %>
<% else %>
  <div class="alert alert-info">
    You have no reservations yet. <%= link_to "Browse cards", cards_path %> and add them to your cart to get started.
  </div>
<% end %>
