<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('reservations.show_title', id: @reservation.id) %></h1>
  <%= link_to t('reservations.back'), reservations_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <% status_colors = { "pending" => "warning", "prepared" => "primary", "paid" => "info", "shipped" => "dark", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
    <p><strong><%= t('reservations.status_label') %></strong> <span class="badge bg-<%= status_colors[@reservation.status] %>"><%= t("statuses.#{@reservation.status}") %></span></p>
    <p><strong><%= t('reservations.date_label') %></strong> <%= @reservation.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></p>
    <% if @reservation.message.present? %>
      <p><strong><%= t('reservations.message_label') %></strong> <%= @reservation.message %></p>
    <% end %>
    <% can_change_shipping = @reservation.pending? || @reservation.prepared? || @reservation.paid? %>
    <% if @reservation.shipping_method.present? %>
      <p>
        <strong><%= t('reservations.shipping_label') %></strong>
        <i class="<%= t("reservations.shipping.icons.#{@reservation.shipping_method}") %> me-1"></i><%= t("reservations.shipping.methods.#{@reservation.shipping_method}") %>
        <% if @reservation.shipping_method == "store_pickup" && @reservation.pickup_location.present? %>
          — <%= t("cart_items.shipping.locations.#{@reservation.pickup_location}") %>
        <% end %>
        <% if can_change_shipping %>
          <a href="#shippingMethodForm" data-bs-toggle="collapse" class="btn btn-sm btn-outline-secondary ms-2">
            <i class="fas fa-pen me-1"></i><%= t('reservations.change_shipping_method') %>
          </a>
        <% end %>
      </p>
    <% elsif can_change_shipping %>
      <div class="alert alert-warning mb-3">
        <i class="fas fa-exclamation-triangle me-1"></i>
        <%= t('reservations.no_shipping_method_notice') %>
      </div>
    <% end %>

    <% if can_change_shipping %>
      <div class="<%= @reservation.shipping_method.present? ? 'collapse' : '' %>" id="shippingMethodForm">
        <%= form_tag update_shipping_method_reservation_path(@reservation), method: :patch do %>
          <div class="row g-2 align-items-end">
            <div class="col-auto">
              <label class="form-label mb-1"><%= t('reservations.choose_shipping_method') %></label>
              <select name="shipping_method" class="form-select form-select-sm" id="user_shipping_method_select" onchange="document.getElementById('user_pickup_location_group').style.display = this.value === 'store_pickup' ? '' : 'none'">
                <% Reservation::SHIPPING_METHODS.each do |method| %>
                  <option value="<%= method %>" <%= 'selected' if @reservation.shipping_method == method %>><%= t("reservations.shipping.methods.#{method}") %></option>
                <% end %>
              </select>
            </div>
            <div class="col-auto" id="user_pickup_location_group" style="<%= @reservation.shipping_method != 'store_pickup' ? 'display: none;' : '' %>">
              <label class="form-label mb-1"><%= t('cart_items.shipping.pickup_location') %></label>
              <select name="pickup_location" class="form-select form-select-sm">
                <% Reservation::PICKUP_LOCATIONS.each do |loc| %>
                  <option value="<%= loc %>" <%= 'selected' if @reservation.pickup_location == loc %>><%= t("cart_items.shipping.locations.#{loc}") %></option>
                <% end %>
              </select>
            </div>
            <div class="col-auto">
              <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-check me-1"></i><%= t('reservations.shipping_info.save') %></button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div id="items" class="d-flex justify-content-between align-items-center mb-2">
  <h4 class="mb-0"><%= t('reservations.items_title') %></h4>
  <div class="btn-group btn-group-sm">
    <%= link_to reservation_path(@reservation, view: "list"), class: "btn #{params[:view] != 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
      </svg>
      <%= t('cards.list') %>
    <% end %>
    <%= link_to reservation_path(@reservation, view: "grid"), class: "btn #{params[:view] == 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
      </svg>
      <%= t('cards.grid') %>
    <% end %>
  </div>
</div>

<% if params[:view] == "grid" %>
  <% items_to_show = @grouped_items || @reservation.reservation_items %>
  <% if admin_or_seller? %>
    <% group_items_by_color_and_type(items_to_show).each do |category, items| %>
      <h5 class="mt-3 mb-2"><%= color_category_label(category) %></h5>
      <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3 mb-3">
        <% items.each do |item| %>
          <div class="col" id="<%= @grouped_items ? "grouped_item_#{item.id}" : dom_id(item) %>">
            <div class="card h-100<%= ' foil-card' if item.card.foil.present? %>">
              <img src="https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=normal"
                   class="card-img-top"
                   alt="<%= item.card.name %>"
                   loading="lazy"
                   onerror="this.onerror=null;this.src='https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=large';this.onerror=function(){this.style.display=\'none\'};">
              <div class="card-body p-2">
                <h6 class="card-title mb-1"><%= item.card.name %></h6>
                <% if item.card.from_new_set? %>
                  <span class="new-set-badge-inline"><%= t('cards.new_set_badge') %></span>
                <% end %>
                <small class="text-muted">
                  <%= item.card.edition_name || item.card.edition.upcase %> #<%= item.card.collector_number %><br>
                  <%= item.card.condition %> · <%= item.card.language %>
                  <% if item.card.foil.present? %>
                    · <i class="fa-solid fa-star" style="color: #d4a017;"></i> <span class="badge" style="background-color: #d4a017;"><%= item.card.foil_display %></span>
                  <% end %>
                </small>
                <div class="mt-1">
                  <strong class="text-price"><%= item.unit_price ? number_to_currency(item.unit_price) : "—" %></strong>
                  <small class="text-muted ms-1">x<%= item.quantity %></small>
                </div>
                <small class="text-muted"><%= t('admin.cards.seller') %>: <%= item.card.seller.name %></small>
                <% if @reservation.pending? %>
                  <div class="mt-1">
                    <%= button_to t('reservations.remove_item'), remove_item_reservation_path(@reservation, item_id: item.id, view: params[:view]), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: t('reservations.remove_item_confirm', name: item.card.name) } %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3 mb-3">
      <% items_to_show.each do |item| %>
        <div class="col" id="<%= @grouped_items ? "grouped_item_#{item.id}" : dom_id(item) %>">
          <div class="card h-100<%= ' foil-card' if item.card.foil.present? %>">
            <img src="https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=normal"
                 class="card-img-top"
                 alt="<%= item.card.name %>"
                 loading="lazy"
                 onerror="this.onerror=null;this.src='https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=large';this.onerror=function(){this.style.display=\'none\'};">
            <div class="card-body p-2">
              <h6 class="card-title mb-1"><%= item.card.name %></h6>
              <% if item.card.from_new_set? %>
                <span class="new-set-badge-inline"><%= t('cards.new_set_badge') %></span>
              <% end %>
              <small class="text-muted">
                <%= item.card.edition_name || item.card.edition.upcase %> #<%= item.card.collector_number %><br>
                <%= item.card.condition %> · <%= item.card.language %>
                <% if item.card.foil.present? %>
                  · <i class="fa-solid fa-star" style="color: #d4a017;"></i> <span class="badge" style="background-color: #d4a017;"><%= item.card.foil_display %></span>
                <% end %>
              </small>
              <div class="mt-1">
                <strong class="text-price"><%= item.unit_price ? number_to_currency(item.unit_price) : "—" %></strong>
                <small class="text-muted ms-1">x<%= item.quantity %></small>
              </div>
              <% if @reservation.pending? %>
                <div class="mt-1">
                  <%= button_to t('reservations.remove_item'), remove_item_reservation_path(@reservation, item_id: item.id, view: params[:view]), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: t('reservations.remove_item_confirm', name: item.card.name) } %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% else %>
<div class="table-responsive">
  <table class="table table-striped">
    <thead class="table-dark">
      <tr>
        <th><%= t('reservations.card_name') %></th>
        <th><%= t('reservations.edition') %></th>
        <th><%= t('reservations.condition') %></th>
        <th><%= t('reservations.language') %></th>
        <th><%= t('reservations.quantity') %></th>
        <% if admin_or_seller? %>
          <th><%= t('admin.cards.seller') %></th>
        <% end %>
        <th><%= t('reservations.price') %></th>
        <th><%= t('reservations.subtotal') %></th>
      </tr>
    </thead>
    <tbody>
      <% items_to_show = @grouped_items || @reservation.reservation_items %>
      <% if admin_or_seller? %>
        <% col_count = 7 + (admin_or_seller? ? 1 : 0) %>
        <% group_items_by_color_and_type(items_to_show).each do |category, items| %>
          <tr>
            <td colspan="<%= col_count %>" class="fw-bold text-white" style="background-color: #6c757d;"><%= color_category_label(category) %></td>
          </tr>
          <% items.each do |item| %>
            <tr id="<%= @grouped_items ? "grouped_item_#{item.id}" : dom_id(item) %>">
              <td>
                <% if @reservation.pending? %>
                  <%= button_to remove_item_reservation_path(@reservation, item_id: item.id, view: params[:view]), method: :delete, class: "btn btn-sm btn-link text-danger p-0 me-2 align-baseline", form: { class: "d-inline", data: { turbo_confirm: t('reservations.remove_item_confirm', name: item.card.name) } }, title: t('reservations.remove_item') do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                <% end %>
                <%= item.card.name %><% if item.card.from_new_set? %> <span class="new-set-badge-inline"><%= t('cards.new_set_badge') %></span><% end %>
              </td>
              <td><%= item.card.edition_name || item.card.edition.upcase %></td>
              <td><%= item.card.condition %></td>
              <td><%= item.card.language %></td>
              <td><%= item.quantity %></td>
              <td><%= item.card.seller.name %></td>
              <td><%= item.unit_price ? number_to_currency(item.unit_price) : "—" %></td>
              <td><%= item.unit_price ? number_to_currency(item.unit_price * item.quantity) : "—" %></td>
            </tr>
          <% end %>
        <% end %>
      <% else %>
        <% items_to_show.each do |item| %>
          <tr id="<%= @grouped_items ? "grouped_item_#{item.id}" : dom_id(item) %>">
            <td>
              <% if @reservation.pending? %>
                <%= button_to remove_item_reservation_path(@reservation, item_id: item.id, view: params[:view]), method: :delete, class: "btn btn-sm btn-link text-danger p-0 me-2 align-baseline", form: { class: "d-inline", data: { turbo_confirm: t('reservations.remove_item_confirm', name: item.card.name) } }, title: t('reservations.remove_item') do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              <% end %>
              <%= item.card.name %><% if item.card.from_new_set? %> <span class="new-set-badge-inline"><%= t('cards.new_set_badge') %></span><% end %>
            </td>
            <td><%= item.card.edition_name || item.card.edition.upcase %></td>
            <td><%= item.card.condition %></td>
            <td><%= item.card.language %></td>
            <td><%= item.quantity %></td>
            <td><%= item.unit_price ? number_to_currency(item.unit_price) : "—" %></td>
            <td><%= item.unit_price ? number_to_currency(item.unit_price * item.quantity) : "—" %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
    <tfoot>
      <tr id="reservation_total">
        <% extra_cols = admin_or_seller? ? 1 : 0 %>
        <td colspan="<%= 6 + extra_cols %>" class="text-end"><strong><%= t('reservations.total') %></strong></td>
        <td><strong><%= number_to_currency((@grouped_items || @reservation.reservation_items).sum { |i| (i.unit_price || 0) * i.quantity }) %></strong></td>
      </tr>
    </tfoot>
  </table>
</div>
<% end %>

<%# --- Shipping info section (non-store-pickup, prepared) --- %>
<% if @reservation.shipping_method.present? && @reservation.shipping_method != "store_pickup" %>
  <% addr = current_user.addresses.first || current_user.addresses.build %>
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i><%= t('reservations.shipping_info.title') %></h5>
    </div>
    <div class="card-body">
      <% if @reservation.pending? || @reservation.prepared? || @reservation.paid? %>
        <%= form_tag update_shipping_info_reservation_path(@reservation), method: :patch do %>
          <% user_errors = current_user.errors %>
          <% addr_errors = addr.errors %>
          <h6 class="mb-3"><i class="fas fa-user me-1"></i><%= t('reservations.shipping_info.personal_title') %></h6>
          <div class="row g-3 mb-4">
            <div class="col-md-12">
              <label class="form-label"><%= t('reservations.shipping_info.full_name') %></label>
              <input type="text" name="user[name]" value="<%= current_user.name %>" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label"><%= t('reservations.shipping_info.phone') %></label>
              <input type="text" name="user[phone_number]" value="<%= current_user.phone_number %>" class="form-control <%= 'is-invalid' if user_errors[:phone_number].any? %>" placeholder="<%= t('reservations.shipping_info.phone_placeholder') %>">
              <% if user_errors[:phone_number].any? %>
                <div class="invalid-feedback"><%= user_errors.full_messages_for(:phone_number).join(", ") %></div>
              <% end %>
            </div>
            <div class="col-md-6">
              <label class="form-label"><%= t('reservations.shipping_info.dni') %></label>
              <input type="text" name="user[dni]" value="<%= current_user.dni %>" class="form-control <%= 'is-invalid' if user_errors[:dni].any? %>" placeholder="<%= t('reservations.shipping_info.dni_placeholder') %>">
              <% if user_errors[:dni].any? %>
                <div class="invalid-feedback"><%= user_errors.full_messages_for(:dni).join(", ") %></div>
              <% end %>
            </div>
          </div>

          <h6 class="mb-3"><i class="fas fa-home me-1"></i><%= t('reservations.shipping_info.address_title') %></h6>
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label"><%= t('reservations.shipping_info.address') %></label>
              <input type="text" name="address[address]" value="<%= addr.address %>" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label"><%= t('reservations.shipping_info.address_number') %></label>
              <input type="text" name="address[address_number]" value="<%= addr.address_number %>" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label"><%= t('reservations.shipping_info.zipcode') %></label>
              <input type="text" name="address[zipcode]" value="<%= addr.zipcode %>" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label"><%= t('reservations.shipping_info.city') %></label>
              <input type="text" name="address[city]" value="<%= addr.city %>" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label"><%= t('reservations.shipping_info.province') %></label>
              <% bike_delivery = @reservation.shipping_method == "bike_delivery" %>
              <% selected_province = bike_delivery ? "caba" : addr.province %>
              <select name="address[province]" class="form-select" <%= 'disabled' if bike_delivery %>>
                <option value=""><%= t('reservations.shipping_info.select_province') %></option>
                <% %w[buenos_aires caba catamarca chaco chubut cordoba corrientes entre_rios formosa jujuy la_pampa la_rioja mendoza misiones neuquen rio_negro salta san_juan san_luis santa_cruz santa_fe santiago_del_estero tierra_del_fuego tucuman].each do |prov| %>
                  <option value="<%= prov %>" <%= 'selected' if selected_province == prov %>><%= t("reservations.shipping_info.provinces.#{prov}") %></option>
                <% end %>
              </select>
              <% if bike_delivery %>
                <input type="hidden" name="address[province]" value="caba">
              <% end %>
            </div>
            <div class="col-md-12">
              <label class="form-label"><%= t('reservations.shipping_info.between_streets') %></label>
              <input type="text" name="address[between_streets]" value="<%= addr.between_streets %>" class="form-control" placeholder="<%= t('reservations.shipping_info.between_streets_placeholder') %>">
            </div>
          </div>
          <div class="mt-3">
            <%= submit_tag t('reservations.shipping_info.save'), class: "btn btn-primary" %>
          </div>
        <% end %>
      <% else %>
        <dl class="row mb-0">
          <% if current_user.name.present? %>
            <dt class="col-sm-4"><%= t('reservations.shipping_info.full_name') %></dt>
            <dd class="col-sm-8"><%= current_user.name %></dd>
          <% end %>
          <% if current_user.phone_number.present? %>
            <dt class="col-sm-4"><%= t('reservations.shipping_info.phone') %></dt>
            <dd class="col-sm-8"><%= current_user.phone_number %></dd>
          <% end %>
          <% if current_user.dni.present? %>
            <dt class="col-sm-4"><%= t('reservations.shipping_info.dni') %></dt>
            <dd class="col-sm-8"><%= current_user.dni %></dd>
          <% end %>
          <% if addr.address.present? %>
            <dt class="col-sm-4"><%= t('reservations.shipping_info.address') %></dt>
            <dd class="col-sm-8"><%= [addr.address, addr.address_number].compact_blank.join(" ") %></dd>
          <% end %>
          <% if addr.city.present? || addr.province.present? %>
            <dt class="col-sm-4"><%= t('reservations.shipping_info.city') %> / <%= t('reservations.shipping_info.province') %></dt>
            <dd class="col-sm-8"><%= [addr.city, addr.province.present? ? t("reservations.shipping_info.provinces.#{addr.province}", default: addr.province) : nil, addr.zipcode].compact_blank.join(", ") %></dd>
          <% end %>
          <% if addr.between_streets.present? %>
            <dt class="col-sm-4"><%= t('reservations.shipping_info.between_streets') %></dt>
            <dd class="col-sm-8"><%= addr.between_streets %></dd>
          <% end %>
        </dl>
      <% end %>
    </div>
  </div>
<% end %>

<%# --- Payment info section --- %>
<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i><%= t('reservations.payment.title') %></h5>
  </div>
  <div class="card-body">
    <% if @reservation.prepared? %>
      <% total_usd = @reservation.total_price %>
      <% if blue_dollar_rate && blue_dollar_rate > 0 %>
        <div class="alert alert-info mb-3">
          <i class="fas fa-exchange-alt me-1"></i>
          <%= t('reservations.payment.exchange_rate', rate: number_with_delimiter(blue_dollar_rate.round(2)), total_pesos: number_with_delimiter((total_usd * blue_dollar_rate).round(2))) %>
          <br><small class="text-muted"><%= t('reservations.payment.exchange_source') %></small>
        </div>
      <% end %>

      <% if @reservation.payment_method.blank? %>
        <h6><%= t('reservations.payment.choose_method') %></h6>
        <div class="row g-3">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-body text-center">
                <h6 class="card-title"><i class="fas fa-money-bill-wave me-2"></i><%= t('reservations.payment.cash_title') %></h6>
                <p><%= t('reservations.payment.cash_description') %></p>
                <%= button_to set_payment_method_reservation_path(@reservation, payment_method: "cash"), method: :patch, class: "btn btn-outline-primary" do %>
                  <i class="fas fa-check me-1"></i><%= t('reservations.payment.choose_cash') %>
                <% end %>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-body text-center">
                <h6 class="card-title"><i class="fas fa-university me-2"></i><%= t('reservations.payment.transfer_title') %></h6>
                <p><%= t('reservations.payment.transfer_description_short') %></p>
                <%= button_to set_payment_method_reservation_path(@reservation, payment_method: "transfer"), method: :patch, class: "btn btn-outline-primary" do %>
                  <i class="fas fa-check me-1"></i><%= t('reservations.payment.choose_transfer') %>
                <% end %>
              </div>
            </div>
          </div>
        </div>

      <% elsif @reservation.payment_method == "cash" %>
        <div class="alert alert-info mb-0">
          <h6 class="alert-heading"><i class="fas fa-money-bill-wave me-2"></i><%= t('reservations.payment.cash_title') %></h6>
          <p class="mb-0"><%= t('reservations.payment.cash_selected') %></p>
        </div>

      <% elsif @reservation.payment_method == "transfer" %>
        <h6><i class="fas fa-university me-2"></i><%= t('reservations.payment.transfer_title') %></h6>
        <p><%= t('reservations.payment.transfer_instructions') %></p>
        <dl class="row mb-0">
          <dt class="col-sm-3"><%= t('reservations.payment.alias') %></dt>
          <dd class="col-sm-9"><code>matilaino.bru</code></dd>
          <dt class="col-sm-3"><%= t('reservations.payment.cbu') %></dt>
          <dd class="col-sm-9"><code>1430001713047505060018</code></dd>
          <% if blue_dollar_rate && blue_dollar_rate > 0 %>
            <dt class="col-sm-3"><%= t('reservations.payment.amount_pesos') %></dt>
            <dd class="col-sm-9"><strong class="text-price">$ <%= number_with_delimiter((total_usd * blue_dollar_rate).round(2)) %></strong></dd>
          <% end %>
        </dl>

        <hr>
        <% if @reservation.receipt_sent_at.present? %>
          <div class="alert alert-success mb-0">
            <i class="fas fa-check-circle me-1"></i>
            <%= t('reservations.payment.receipt_sent', time: @reservation.receipt_sent_at.in_time_zone.strftime("%d/%m/%Y %H:%M")) %>
          </div>
        <% else %>
          <h6 class="mt-3"><%= t('reservations.payment.upload_receipt_title') %></h6>
          <p class="text-muted"><%= t('reservations.payment.upload_receipt_description') %></p>
          <%= form_tag upload_receipt_reservation_path(@reservation), method: :post, multipart: true, class: "d-flex align-items-center gap-2 flex-wrap" do %>
            <%= file_field_tag :receipt, accept: "image/jpeg,image/png,image/webp,application/pdf", class: "form-control form-control-sm", style: "max-width: 300px;" %>
            <%= submit_tag t('reservations.payment.send_receipt'), class: "btn btn-primary btn-sm" %>
          <% end %>
        <% end %>
      <% end %>

    <% elsif @reservation.paid? || @reservation.shipped? || @reservation.fulfilled? %>
      <p class="text-success"><i class="fas fa-check-circle me-1"></i> <%= t('reservations.payment.already_paid') %></p>
      <% if @reservation.payment_method.present? %>
        <p class="mb-0"><strong><%= t('reservations.payment.method_chosen') %></strong> <%= t("reservations.payment.methods.#{@reservation.payment_method}") %></p>
      <% end %>
    <% else %>
      <p class="mb-0 text-muted"><i class="fas fa-clock me-1"></i> <%= t('reservations.payment.not_yet_prepared') %></p>
    <% end %>

    <% if @reservation.prepared? || @reservation.paid? || @reservation.shipped? || @reservation.fulfilled? %>
      <hr>
      <a href="https://wa.me/5491163572143?text=<%= CGI.escape(t('reservations.payment.whatsapp_message', id: @reservation.id)) %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success">
        <i class="fab fa-whatsapp me-1"></i><%= t('reservations.payment.whatsapp_contact') %>
      </a>
    <% end %>
  </div>
</div>

<% if @reservation.tracking_number.present? %>
<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0"><i class="fas fa-shipping-fast me-2"></i><%= t('reservations.tracking.title') %></h5>
  </div>
  <div class="card-body">
    <p>
      <strong><%= t('reservations.tracking.number_label') %></strong> <%= @reservation.tracking_number %>
    </p>
    <% if @reservation.tracking_url.present? %>
      <a href="<%= @reservation.tracking_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">
        <i class="fas fa-external-link-alt me-1"></i><%= t('reservations.tracking.track_shipment') %>
      </a>
    <% end %>
  </div>
</div>
<% end %>

<% if @reservation.pending? %>
  <div class="card mb-3" data-controller="add-item-search" data-search-url="<%= search_cards_reservation_path(@reservation) %>">
    <div class="card-header">
      <h5 class="mb-0"><%= t('reservations.add_cards') %></h5>
    </div>
    <div class="card-body">
      <div class="input-group mb-3">
        <input type="text" class="form-control"
               placeholder="<%= t('reservations.search_cards_placeholder') %>"
               data-add-item-search-target="searchInput"
               data-action="keydown.enter->add-item-search#search">
        <button type="button" class="btn btn-outline-primary"
                data-action="click->add-item-search#search">
          <%= t('cards.search') %>
        </button>
      </div>
      <div data-add-item-search-target="searchResults"></div>
    </div>
  </div>
<% end %>

<div id="notes">
  <h4 class="mt-4"><%= t('reservations.notes.title') %></h4>
  <div class="card mb-3">
    <div class="card-body">
      <% public_notes = @reservation.reservation_notes.public_notes.order(created_at: :asc) %>
      <% if public_notes.any? %>
        <% public_notes.each do |note| %>
          <div class="mb-2">
            <strong><%= note.user&.admin? ? t('reservations.notes.admin_label') : note.user&.name %></strong>
            <small class="text-muted ms-2"><%= note.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></small>
            <p class="mb-0"><%= simple_format(note.body) %></p>
          </div>
          <hr class="my-1">
        <% end %>
      <% else %>
        <p class="text-muted mb-2"><%= t('reservations.notes.empty') %></p>
      <% end %>

      <%= form_tag reservation_notes_path(@reservation), method: :post, class: "mt-2" do %>
        <div class="mb-2">
          <textarea name="body" class="form-control" rows="2" placeholder="<%= t('reservations.notes.placeholder') %>" required></textarea>
        </div>
        <%= submit_tag t('reservations.notes.add'), class: "btn btn-sm btn-outline-primary" %>
      <% end %>
    </div>
  </div>
</div>

<% if @reservation.pending? || @reservation.prepared? %>
  <div class="mt-3">
    <%= button_to t('reservations.cancel'), cancel_reservation_path(@reservation), method: :patch, class: "btn btn-danger", data: { turbo_confirm: t('reservations.cancel_confirm') } %>
  </div>
<% end %>
