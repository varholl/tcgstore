<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Reservation #<%= @reservation.id %></h1>
  <%= link_to "Back to Reservations", reservations_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <% status_colors = { "pending" => "warning", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
    <p><strong>Status:</strong> <span class="badge bg-<%= status_colors[@reservation.status] %>"><%= @reservation.status.capitalize %></span></p>
    <p><strong>Date:</strong> <%= @reservation.created_at.strftime("%b %d, %Y %H:%M") %></p>
    <% if @reservation.message.present? %>
      <p><strong>Message:</strong> <%= @reservation.message %></p>
    <% end %>
  </div>
</div>

<h4>Items</h4>
<div class="table-responsive">
  <table class="table table-striped">
    <thead class="table-dark">
      <tr>
        <th>Card Name</th>
        <th>Edition</th>
        <th>Condition</th>
        <th>Quantity</th>
      </tr>
    </thead>
    <tbody>
      <% @reservation.reservation_items.each do |item| %>
        <tr>
          <td><%= item.card.name %></td>
          <td><%= item.card.edition_name || item.card.edition.upcase %></td>
          <td><%= item.card.condition %></td>
          <td><%= item.quantity %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @reservation.pending? %>
  <div class="mt-3">
    <%= button_to "Cancel Reservation", cancel_reservation_path(@reservation), method: :patch, class: "btn btn-danger", data: { confirm: "Are you sure you want to cancel this reservation?" } %>
  </div>
<% end %>
