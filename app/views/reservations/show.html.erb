<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('reservations.show_title', id: @reservation.id) %></h1>
  <%= link_to t('reservations.back'), reservations_path, class: "btn btn-outline-secondary" %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <% status_colors = { "pending" => "warning", "prepared" => "primary", "paid" => "info", "fulfilled" => "success", "expired" => "secondary", "cancelled" => "danger" } %>
    <p><strong><%= t('reservations.status_label') %></strong> <span class="badge bg-<%= status_colors[@reservation.status] %>"><%= t("statuses.#{@reservation.status}") %></span></p>
    <p><strong><%= t('reservations.date_label') %></strong> <%= @reservation.created_at.in_time_zone.strftime("%d/%m/%Y %H:%M") %></p>
    <% if @reservation.message.present? %>
      <p><strong><%= t('reservations.message_label') %></strong> <%= @reservation.message %></p>
    <% end %>
  </div>
</div>

<div id="items" class="d-flex justify-content-between align-items-center mb-2">
  <h4 class="mb-0"><%= t('reservations.items_title') %></h4>
  <div class="btn-group btn-group-sm">
    <%= link_to reservation_path(@reservation, view: "list"), class: "btn #{params[:view] != 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
      </svg>
      <%= t('cards.list') %>
    <% end %>
    <%= link_to reservation_path(@reservation, view: "grid"), class: "btn #{params[:view] == 'grid' ? 'btn-primary' : 'btn-outline-primary'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
      </svg>
      <%= t('cards.grid') %>
    <% end %>
  </div>
</div>

<% if params[:view] == "grid" %>
  <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3 mb-3">
    <% @reservation.reservation_items.each do |item| %>
      <div class="col">
        <div class="card h-100<%= ' foil-card' if item.card.foil.present? %>">
          <img src="https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=normal"
               class="card-img-top"
               alt="<%= item.card.name %>"
               loading="lazy"
               onerror="this.onerror=null;this.src='https://api.scryfall.com/cards/<%= item.card.edition %>/<%= item.card.collector_number %>?format=image&version=large';this.onerror=function(){this.style.display=\'none\'};">
          <div class="card-body p-2">
            <h6 class="card-title mb-1"><%= item.card.name %></h6>
            <small class="text-muted">
              <%= item.card.edition_name || item.card.edition.upcase %> #<%= item.card.collector_number %><br>
              <%= item.card.condition %> · <%= item.card.language %>
              <% if item.card.foil.present? %>
                · <i class="fa-solid fa-star" style="color: #d4a017;"></i> <span class="badge" style="background-color: #d4a017;"><%= t('cards.foil_badge') %></span>
              <% end %>
            </small>
            <div class="mt-1">
              <strong class="text-price"><%= item.unit_price ? number_to_currency(item.unit_price) : "—" %></strong>
              <small class="text-muted ms-1">x<%= item.quantity %></small>
            </div>
            <% if @reservation.pending? %>
              <div class="mt-1">
                <%= button_to t('reservations.remove_item'), remove_item_reservation_path(@reservation, item_id: item.id), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: t('reservations.remove_item_confirm', name: item.card.name) } %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
<div class="table-responsive">
  <table class="table table-striped">
    <thead class="table-dark">
      <tr>
        <th><%= t('reservations.card_name') %></th>
        <th><%= t('reservations.edition') %></th>
        <th><%= t('reservations.condition') %></th>
        <th><%= t('reservations.language') %></th>
        <th><%= t('reservations.quantity') %></th>
        <th><%= t('reservations.price') %></th>
        <th><%= t('reservations.subtotal') %></th>
        <% if @reservation.pending? %>
          <th></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @reservation.reservation_items.each do |item| %>
        <tr>
          <td><%= item.card.name %></td>
          <td><%= item.card.edition_name || item.card.edition.upcase %></td>
          <td><%= item.card.condition %></td>
          <td><%= item.card.language %></td>
          <td><%= item.quantity %></td>
          <td><%= item.unit_price ? number_to_currency(item.unit_price) : "—" %></td>
          <td><%= item.unit_price ? number_to_currency(item.unit_price * item.quantity) : "—" %></td>
          <% if @reservation.pending? %>
            <td>
              <%= button_to t('reservations.remove_item'), remove_item_reservation_path(@reservation, item_id: item.id), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: t('reservations.remove_item_confirm', name: item.card.name) } %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="<%= @reservation.pending? ? 7 : 6 %>" class="text-end"><strong><%= t('reservations.total') %></strong></td>
        <td><strong><%= number_to_currency(@reservation.reservation_items.sum { |i| (i.unit_price || 0) * i.quantity }) %></strong></td>
      </tr>
    </tfoot>
  </table>
</div>
<% end %>

<%# --- Payment info section --- %>
<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i><%= t('reservations.payment.title') %></h5>
  </div>
  <div class="card-body">
    <% if @reservation.prepared? %>
      <% total_usd = @reservation.total_price %>
      <% if blue_dollar_rate && blue_dollar_rate > 0 %>
        <div class="alert alert-info mb-3">
          <i class="fas fa-exchange-alt me-1"></i>
          <%= t('reservations.payment.exchange_rate', rate: number_with_delimiter(blue_dollar_rate.round(2)), total_pesos: number_with_delimiter((total_usd * blue_dollar_rate).round(2))) %>
          <br><small class="text-muted"><%= t('reservations.payment.exchange_source') %></small>
        </div>
      <% end %>

      <% if @reservation.payment_method.blank? %>
        <h6><%= t('reservations.payment.choose_method') %></h6>
        <div class="row g-3">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-body text-center">
                <h6 class="card-title"><i class="fas fa-money-bill-wave me-2"></i><%= t('reservations.payment.cash_title') %></h6>
                <p><%= t('reservations.payment.cash_description') %></p>
                <%= button_to set_payment_method_reservation_path(@reservation, payment_method: "cash"), method: :patch, class: "btn btn-outline-primary" do %>
                  <i class="fas fa-check me-1"></i><%= t('reservations.payment.choose_cash') %>
                <% end %>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-body text-center">
                <h6 class="card-title"><i class="fas fa-university me-2"></i><%= t('reservations.payment.transfer_title') %></h6>
                <p><%= t('reservations.payment.transfer_description_short') %></p>
                <%= button_to set_payment_method_reservation_path(@reservation, payment_method: "transfer"), method: :patch, class: "btn btn-outline-primary" do %>
                  <i class="fas fa-check me-1"></i><%= t('reservations.payment.choose_transfer') %>
                <% end %>
              </div>
            </div>
          </div>
        </div>

      <% elsif @reservation.payment_method == "cash" %>
        <div class="alert alert-info mb-0">
          <h6 class="alert-heading"><i class="fas fa-money-bill-wave me-2"></i><%= t('reservations.payment.cash_title') %></h6>
          <p class="mb-0"><%= t('reservations.payment.cash_selected') %></p>
        </div>

      <% elsif @reservation.payment_method == "transfer" %>
        <h6><i class="fas fa-university me-2"></i><%= t('reservations.payment.transfer_title') %></h6>
        <p><%= t('reservations.payment.transfer_instructions') %></p>
        <dl class="row mb-0">
          <dt class="col-sm-3"><%= t('reservations.payment.alias') %></dt>
          <dd class="col-sm-9"><code>matilaino.bru</code></dd>
          <dt class="col-sm-3"><%= t('reservations.payment.cbu') %></dt>
          <dd class="col-sm-9"><code>1430001713047505060018</code></dd>
          <% if blue_dollar_rate && blue_dollar_rate > 0 %>
            <dt class="col-sm-3"><%= t('reservations.payment.amount_pesos') %></dt>
            <dd class="col-sm-9"><strong class="text-price">$ <%= number_with_delimiter((total_usd * blue_dollar_rate).round(2)) %></strong></dd>
          <% end %>
        </dl>

        <hr>
        <% if @reservation.receipt_sent_at.present? %>
          <div class="alert alert-success mb-0">
            <i class="fas fa-check-circle me-1"></i>
            <%= t('reservations.payment.receipt_sent', time: @reservation.receipt_sent_at.in_time_zone.strftime("%d/%m/%Y %H:%M")) %>
          </div>
        <% else %>
          <h6 class="mt-3"><%= t('reservations.payment.upload_receipt_title') %></h6>
          <p class="text-muted"><%= t('reservations.payment.upload_receipt_description') %></p>
          <%= form_tag upload_receipt_reservation_path(@reservation), method: :post, multipart: true, class: "d-flex align-items-center gap-2 flex-wrap" do %>
            <%= file_field_tag :receipt, accept: "image/jpeg,image/png,image/webp,application/pdf", class: "form-control form-control-sm", style: "max-width: 300px;" %>
            <%= submit_tag t('reservations.payment.send_receipt'), class: "btn btn-primary btn-sm" %>
          <% end %>
        <% end %>
      <% end %>

    <% elsif @reservation.paid? || @reservation.fulfilled? %>
      <p class="text-success"><i class="fas fa-check-circle me-1"></i> <%= t('reservations.payment.already_paid') %></p>
      <% if @reservation.payment_method.present? %>
        <p class="mb-0"><strong><%= t('reservations.payment.method_chosen') %></strong> <%= t("reservations.payment.methods.#{@reservation.payment_method}") %></p>
      <% end %>
    <% else %>
      <p class="mb-0 text-muted"><i class="fas fa-clock me-1"></i> <%= t('reservations.payment.not_yet_prepared') %></p>
    <% end %>

    <% if @reservation.prepared? || @reservation.paid? || @reservation.fulfilled? %>
      <hr>
      <a href="https://wa.me/5491163572143?text=<%= CGI.escape(t('reservations.payment.whatsapp_message', id: @reservation.id)) %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success">
        <i class="fab fa-whatsapp me-1"></i><%= t('reservations.payment.whatsapp_contact') %>
      </a>
    <% end %>
  </div>
</div>

<% if @reservation.pending? %>
  <div class="card mb-3" data-controller="add-item-search" data-search-url="<%= search_cards_reservation_path(@reservation) %>">
    <div class="card-header">
      <h5 class="mb-0"><%= t('reservations.add_cards') %></h5>
    </div>
    <div class="card-body">
      <div class="input-group mb-3">
        <input type="text" class="form-control"
               placeholder="<%= t('reservations.search_cards_placeholder') %>"
               data-add-item-search-target="searchInput"
               data-action="keydown.enter->add-item-search#search">
        <button type="button" class="btn btn-outline-primary"
                data-action="click->add-item-search#search">
          <%= t('cards.search') %>
        </button>
      </div>
      <div data-add-item-search-target="searchResults"></div>
    </div>
  </div>
<% end %>

<% if @reservation.pending? || @reservation.prepared? %>
  <div class="mt-3">
    <%= button_to t('reservations.cancel'), cancel_reservation_path(@reservation), method: :patch, class: "btn btn-danger", data: { turbo_confirm: t('reservations.cancel_confirm') } %>
  </div>
<% end %>
