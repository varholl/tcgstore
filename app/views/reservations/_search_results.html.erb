<% if cards.any? %>
  <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
    <% cards.each do |card| %>
      <% available = card.available_quantity %>
      <div class="col">
        <div class="card h-100<%= ' foil-card' if card.foil.present? %>">
          <img src="https://api.scryfall.com/cards/<%= card.edition %>/<%= card.collector_number %>?format=image&version=normal"
               class="card-img-top"
               alt="<%= card.name %>"
               loading="lazy"
               onerror="this.onerror=null;this.style.display='none';">
          <div class="card-body p-2">
            <h6 class="card-title mb-1">
              <%= card.name %>
              <% if card.foil.present? %>
                <span class="badge" style="background-color: #d4a017;"><%= card.foil_display %></span>
              <% end %>
            </h6>
            <small class="text-muted">
              <%= card.edition_name || card.edition.upcase %><br>
              <%= card.condition %>
            </small>
            <div class="mt-1">
              <strong><%= card.price ? number_to_currency(card.price) : "—" %></strong>
              <small class="text-muted ms-1">(<%= available %> <%= t('reservations.available').downcase %>)</small>
            </div>
            <% if available > 0 %>
              <div class="mt-2">
                <%= form_tag add_item_reservation_path(reservation), method: :post, class: "d-flex align-items-center gap-1" do %>
                  <input type="hidden" name="card_id" value="<%= card.id %>">
                  <input type="number" name="quantity" value="1" min="1" max="<%= available %>" class="form-control form-control-sm" style="width: 60px;">
                  <button type="submit" class="btn btn-sm btn-outline-success"><%= t('reservations.add') %></button>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted"><%= t('reservations.no_cards_found') %></p>
<% end %>
