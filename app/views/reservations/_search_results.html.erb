<% if cards.any? %>
  <table class="table table-sm table-striped">
    <thead>
      <tr>
        <th><%= t('reservations.card_name') %></th>
        <th><%= t('reservations.edition') %></th>
        <th><%= t('reservations.condition') %></th>
        <th><%= t('reservations.price') %></th>
        <th><%= t('reservations.available') %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% cards.each do |card| %>
        <% available = card.available_quantity %>
        <tr>
          <td>
            <%= card.name %>
            <% if card.foil.present? %>
              <span class="badge" style="background-color: #d4a017;"><%= t('cards.foil_badge') %></span>
            <% end %>
          </td>
          <td><%= card.edition_name || card.edition.upcase %></td>
          <td><%= card.condition %></td>
          <td><%= card.price ? number_to_currency(card.price) : "—" %></td>
          <td><%= available %></td>
          <td>
            <% if available > 0 %>
              <%= form_tag add_item_reservation_path(reservation), method: :post, class: "d-flex align-items-center gap-1" do %>
                <input type="hidden" name="card_id" value="<%= card.id %>">
                <input type="number" name="quantity" value="1" min="1" max="<%= available %>" class="form-control form-control-sm" style="width: 60px;">
                <button type="submit" class="btn btn-sm btn-outline-success"><%= t('reservations.add') %></button>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted"><%= t('reservations.no_cards_found') %></p>
<% end %>
